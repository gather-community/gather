#!/usr/bin/env bash
#MISE description="Interactive setup for Gather development environment"
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_DIR="$SCRIPT_DIR/../templates"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# -----------------------------------------------------------------------------
# Config file paths
# -----------------------------------------------------------------------------
CONFIG_FILES=(
  "config/database.yml"
  "config/settings.local.yml"
  "docker-compose.yml"
)

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
info() { gum style --foreground 2 "==> $1"; }
warn() { gum style --foreground 3 "==> $1"; }
error() { gum style --foreground 1 "ERROR: $1"; exit 1; }

show_header() {
  local step="${1:-}"
  clear
  if [[ -n "$step" ]]; then
    gum style --border normal --padding "1 2" --border-foreground 212 \
      "Gather Development Setup" \
      "Step: $step"
  else
    gum style --border normal --padding "1 2" --border-foreground 212 \
      "Gather Development Setup"
  fi
  echo ""
}

check_icon() {
  if [[ "$1" == "true" ]]; then
    gum style --foreground 2 "✓"
  else
    gum style --foreground 1 "✗"
  fi
}

# -----------------------------------------------------------------------------
# Dependency checks
# -----------------------------------------------------------------------------
declare -A DEP_STATUS

check_dependencies() {
  # gum (required to run)
  if command -v gum >/dev/null 2>&1; then
    DEP_STATUS[gum]="true"
  else
    echo "ERROR: gum is required but not installed."
    exit 1
  fi

  # gomplate
  if command -v gomplate >/dev/null 2>&1; then
    DEP_STATUS[gomplate]="true"
  else
    DEP_STATUS[gomplate]="false"
  fi

  # jq
  if command -v jq >/dev/null 2>&1; then
    DEP_STATUS[jq]="true"
  else
    DEP_STATUS[jq]="false"
  fi

  # libvips
  if command -v vips >/dev/null 2>&1; then
    VIPS_VERSION=$(vips --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    VIPS_MAJOR=$(echo "$VIPS_VERSION" | cut -d. -f1)
    VIPS_MINOR=$(echo "$VIPS_VERSION" | cut -d. -f2)
    if [[ "$VIPS_MAJOR" -gt 8 ]] || [[ "$VIPS_MAJOR" -eq 8 && "$VIPS_MINOR" -ge 8 ]]; then
      DEP_STATUS[libvips]="true"
      DEP_STATUS[libvips_version]="$VIPS_VERSION"
    else
      DEP_STATUS[libvips]="false"
      DEP_STATUS[libvips_version]="$VIPS_VERSION (too old)"
    fi
  else
    DEP_STATUS[libvips]="false"
    DEP_STATUS[libvips_version]="not found"
  fi
}

# -----------------------------------------------------------------------------
# Config file checks
# -----------------------------------------------------------------------------
declare -A CONFIG_STATUS

check_config_files() {
  for file in "${CONFIG_FILES[@]}"; do
    if [[ -f "$PROJECT_ROOT/$file" ]]; then
      CONFIG_STATUS[$file]="true"
    else
      CONFIG_STATUS[$file]="false"
    fi
  done
}

config_files_exist() {
  for file in "${CONFIG_FILES[@]}"; do
    if [[ "${CONFIG_STATUS[$file]}" == "true" ]]; then
      return 0
    fi
  done
  return 1
}

all_deps_ok() {
  [[ "${DEP_STATUS[gomplate]}" == "true" ]] && \
  [[ "${DEP_STATUS[jq]}" == "true" ]] && \
  [[ "${DEP_STATUS[libvips]}" == "true" ]]
}

# -----------------------------------------------------------------------------
# Display status summary
# -----------------------------------------------------------------------------
show_status_summary() {
  show_header
  gum style --bold "Dependencies"
  echo ""
  echo "  gomplate    $(check_icon "${DEP_STATUS[gomplate]}")"
  echo "  jq          $(check_icon "${DEP_STATUS[jq]}")"
  echo "  libvips     $(check_icon "${DEP_STATUS[libvips]}")  ${DEP_STATUS[libvips_version]:-}"
  echo "  gems        $(check_icon "${DEP_STATUS[gems]}")"
  echo ""

  gum style --bold "Config Files"
  echo ""
  for file in "${CONFIG_FILES[@]}"; do
    if [[ "${CONFIG_STATUS[$file]}" == "true" ]]; then
      echo "  $file  $(gum style --foreground 2 "exists")"
    else
      echo "  $file  $(gum style --foreground 8 "not found")"
    fi
  done
  echo ""
}

# -----------------------------------------------------------------------------
# View config file
# -----------------------------------------------------------------------------
view_config_file() {
  local file="$1"
  local filepath="$PROJECT_ROOT/$file"

  if [[ ! -f "$filepath" ]]; then
    warn "File not found: $file"
    gum input --placeholder "Press Enter to continue..."
    return
  fi

  show_header "Viewing $file"

  if [[ "$file" == "docker-compose.yml" ]]; then
    gum pager < "$filepath"
  else
    # Render YAML as table-like format
    gum pager < "$filepath"
  fi
}

# -----------------------------------------------------------------------------
# Generate config files
# -----------------------------------------------------------------------------
generate_config() {
  if ! all_deps_ok; then
    echo ""
    gum style --foreground 1 "Cannot generate config: missing dependencies"
    echo ""
    echo "Please install:"
    [[ "${DEP_STATUS[gomplate]}" != "true" ]] && echo "  - gomplate"
    [[ "${DEP_STATUS[jq]}" != "true" ]] && echo "  - jq"
    [[ "${DEP_STATUS[libvips]}" != "true" ]] && echo "  - libvips v8.8+"
    echo ""
    gum input --placeholder "Press Enter to continue..."
    return
  fi

  show_header

  # Check for existing files
  local existing=()
  for file in "${CONFIG_FILES[@]}"; do
    [[ "${CONFIG_STATUS[$file]}" == "true" ]] && existing+=("$file")
  done

  if [[ ${#existing[@]} -gt 0 ]]; then
    gum style --foreground 3 --bold "Warning: The following files will be overwritten:"
    for f in "${existing[@]}"; do
      echo "  - $f"
    done
    echo ""
    if ! gum confirm "Do you want to continue?"; then
      return
    fi
  fi

  # -- PostgreSQL -------------------------------------------------------------
  show_header "PostgreSQL"

  pg_source=$(gum choose --header "Source:" \
    "Use an existing instance" \
    "Run in a container")

  if [[ "$pg_source" == "Use an existing instance" ]]; then
    pg_source="existing"
    pg_host=$(gum input --value "localhost" --header "Host:")
    pg_port=$(gum input --value "5432" --header "Port:")
    pg_user=$(gum input --placeholder "postgres" --header "Username (blank for default):")
    pg_password=$(gum input --password --placeholder "" --header "Password (blank for none):")
  else
    pg_source="docker"
    pg_host="localhost"
    pg_port="5432"
    pg_user=$(gum input --value "gather" --header "Username:")
    pg_password=$(gum input --value "gather" --header "Password:")
  fi

  # -- Redis ------------------------------------------------------------------
  show_header "Redis"

  redis_source=$(gum choose --header "Source:" \
    "Use an existing instance" \
    "Run in a container")

  if [[ "$redis_source" == "Use an existing instance" ]]; then
    redis_source="existing"
    redis_host=$(gum input --value "localhost" --header "Host:")
    redis_port=$(gum input --value "6379" --header "Port:")
  else
    redis_source="docker"
    redis_host="localhost"
    redis_port="6379"
    info "Redis will run in Docker"
  fi

  # -- Elasticsearch ----------------------------------------------------------
  show_header "Elasticsearch"

  es_source=$(gum choose --header "Source:" \
    "Use an existing instance" \
    "Run in a container")

  if [[ "$es_source" == "Use an existing instance" ]]; then
    es_source="existing"
    es_host=$(gum input --value "localhost" --header "Host:")
    es_port=$(gum input --value "9200" --header "Port:")
  else
    es_source="docker"
    es_host="localhost"
    es_port="9200"
    info "Elasticsearch will run in Docker"
  fi

  # -- Mailcatcher ------------------------------------------------------------
  show_header "Mailcatcher"
  info "Mailcatcher will run in Docker"
  sleep 1

  # -- Google OAuth -----------------------------------------------------------
  show_header "Google OAuth"
  echo "Create an OAuth client at: https://console.cloud.google.com/apis/credentials"
  echo ""
  echo "Configure with:"
  echo "  Authorized JS origins:    https://gatherdev.org:3000"
  echo "  Authorized redirect URIs: https://gatherdev.org:3000/users/auth/google_oauth2/callback"
  echo ""

  google_client_id=$(gum input --placeholder "your-client-id.apps.googleusercontent.com" --header "Client ID:")
  google_client_secret=$(gum input --password --placeholder "" --header "Client Secret:")

  if [[ -z "$google_client_id" ]] || [[ -z "$google_client_secret" ]]; then
    warn "OAuth credentials not provided - you'll need to add them manually later"
    google_client_id="${google_client_id:-REPLACE_ME}"
    google_client_secret="${google_client_secret:-REPLACE_ME}"
  fi

  # -- Build config JSON ------------------------------------------------------
  show_header "Generating Files"
  info "Building configuration..."

  config_file=$(mktemp)
  trap 'rm -f "$config_file"' EXIT

  secret_key=$(openssl rand -hex 64)

  cat > "$config_file" << EOF
{
  "postgres": {
    "source": "$pg_source",
    "host": "$pg_host",
    "port": $pg_port,
    "user": "$pg_user",
    "password": "$pg_password"
  },
  "redis": {
    "source": "$redis_source",
    "host": "$redis_host",
    "port": $redis_port
  },
  "elasticsearch": {
    "source": "$es_source",
    "host": "$es_host",
    "port": $es_port
  },
  "oauth": {
    "google": {
      "client_id": "$google_client_id",
      "client_secret": "$google_client_secret"
    }
  },
  "secrets": {
    "key_base": "$secret_key"
  }
}
EOF

  # -- Generate files ---------------------------------------------------------
  info "Generating config/database.yml..."
  gomplate -d "config=$config_file?type=application/json" \
    -f "$TEMPLATE_DIR/database.yml.tmpl" \
    -o "$PROJECT_ROOT/config/database.yml"

  info "Generating config/settings.local.yml..."
  gomplate -d "config=$config_file?type=application/json" \
    -f "$TEMPLATE_DIR/settings.local.yml.tmpl" \
    -o "$PROJECT_ROOT/config/settings.local.yml"

  info "Generating docker-compose.yml..."
  gomplate -d "config=$config_file?type=application/json" \
    -f "$TEMPLATE_DIR/docker-compose.yml.tmpl" \
    -o "$PROJECT_ROOT/docker-compose.yml"

  # Update config status
  check_config_files

  # -- Summary ----------------------------------------------------------------
  show_header "Complete"
  gum style --border double --padding "1 2" --border-foreground 2 "Setup Complete!"

  echo ""
  echo "Generated files:"
  echo "  - config/database.yml"
  echo "  - config/settings.local.yml"
  echo "  - docker-compose.yml"

  echo ""
  echo "Next steps:"
  echo "  1. Start Docker services:    docker compose up -d"
  echo "  2. Install dependencies:     bundle install && yarn install"
  echo "  3. Setup database:           rake db:create && rake db:schema:load"
  echo "  4. Generate test data:       rake db:new_cluster ADMIN_FNAME=\"Your\" ADMIN_LNAME=\"Name\" ADMIN_EMAIL=\"you@example.com\" SUPER_ADMIN=y"
  echo "  5. Start the server:         bin/dev"
  echo "  6. Start background jobs:    bin/delayed_job run"
  echo ""
  echo "Access the app at:      https://gatherdev.org:3000"
  echo "Mailcatcher UI at:      http://localhost:1080"
  echo ""

  gum input --placeholder "Press Enter to continue..."
}

# -----------------------------------------------------------------------------
# View config files submenu
# -----------------------------------------------------------------------------
show_view_menu() {
  while true; do
    show_header "View Config Files"

    local options=()
    for file in "${CONFIG_FILES[@]}"; do
      if [[ "${CONFIG_STATUS[$file]}" == "true" ]]; then
        options+=("$file")
      fi
    done
    options+=("Back")

    local choice
    choice=$(gum choose --header "Select a file:" "${options[@]}")

    if [[ "$choice" == "Back" ]]; then
      return
    fi

    view_config_file "$choice"
  done
}

# -----------------------------------------------------------------------------
# Main menu
# -----------------------------------------------------------------------------
show_main_menu() {
  local options=()

  options+=("Generate config files")

  if config_files_exist; then
    options+=("View config files")
  fi

  options+=("Exit")

  local choice
  choice=$(gum choose --header "Select an action:" "${options[@]}")

  case "$choice" in
    "Generate config files")
      generate_config
      ;;
    "View config files")
      show_view_menu
      ;;
    "Exit")
      exit 0
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Check and install gems
# -----------------------------------------------------------------------------
check_gems() {
  if bundle check >/dev/null 2>&1; then
    DEP_STATUS[gems]="true"
    return 0
  fi

  show_header "Checking Gems"
  warn "Missing gems detected, installing..."
  echo ""

  if gum spin --spinner dot --title "Running bundle install..." -- bundle install; then
    DEP_STATUS[gems]="true"
    info "Gems installed successfully"
    sleep 1
    return 0
  else
    DEP_STATUS[gems]="false"
    echo ""
    gum style --foreground 1 --bold "Bundle install failed"
    echo ""
    echo "Please run 'bundle install' manually and check the errors for guidance."
    echo ""
    exit 1
  fi
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
main() {
  check_dependencies
  check_gems
  check_config_files

  while true; do
    show_status_summary
    show_main_menu
  done
}

main
