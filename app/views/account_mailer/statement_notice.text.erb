<%= @household.greeting %>

<%= t(".created", community: @community.name) %>

<% if @statement.total_due >= 0 -%>
<%= t(".amount_due", amount: number_to_currency(@statement.total_due)) %>
<% else -%>
<%= t(".credit", amount: number_to_currency(-@statement.total_due)) %>
<% end -%>

<%= t(".see_details") %>

<%= statement_url(@statement) %>

<% if @statement.total_due > 0 -%>
<%= t(".thanks") %>
<% end -%>
