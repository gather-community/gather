<%= @household.greeting %>

<% if (d = @statement.due_on) -%>
<%= t(".due_on", community: @community.name, date: l(d, format: :wday_no_year)) %>
<% else -%>
<%= t(".due_soon", community: @community.name) %>
<% end -%>

<%= t(".amount_due", amount: format_money(@statement.total_due)) %>

<%= statement_url(@statement) %>

<%= t(".disregard") %>

<%= t(".thanks") %>
