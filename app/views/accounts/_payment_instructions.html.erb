<% methods = Billing::PaymentMethodsDecorator.new(account) %>
<div class="payment-instructions">
  <h2><%= t(".how_to_pay") %></h2>
  <%= methods.payment_badge(:paypal) %>
  <%= methods.payment_badge(:online_bill_pay) %>
  <%= methods.payment_badge(:check) %>
  <%= methods.payment_badge(:cash) %>

  <% if methods.pay_with_paypal_me? %>
    <h3><%= t(".paypal") %></h3>
    <%= t(".click_logo") %>
  <% elsif methods.pay_with_paypal_email? %>
    <h3><%= t(".paypal") %></h3>
    <% if methods.paypal_friend? %>
      <ul>
        <li><%= t(".send_paypal_html", email: tag.strong(methods.paypal_email)) %></li>
        <li><%= t(".choose_friend_html", friend: tag.strong(t(".sending_to_friend"))) %></li>
      </ul>
    <% else %>
      <%= t(".send_paypal_html", email: tag.strong(methods.paypal_email)) %>
    <% end %>
  <% end %>

  <% if methods.pay_with_online_bill_pay? %>
    <h3><%= t(".online_bill_pay") %></h3>
    <%= t(".bill_pay_intro") %>
    <ul>
      <li><%= t(".payee_name_html", payee: tag.strong(methods.check_payee)) %></li>
      <li><%= t(".account_number_html", number: tag.strong(methods.number_padded)) %></li>
      <li><%= t(".address") %><div class="check-address"><%= simple_format(methods.check_address) %></div></li>
    </ul>
  <% end %>

  <% if methods.pay_with_check? %>
    <h3><%= t(".check") %></h3>
    <ul>
      <% if methods.check_payee %>
        <li><%= t(".payable_to_html", payee: tag.strong(methods.check_payee)) %></li>
      <% end %>
      <li><%= t(".memo_line_html", number: tag.strong(methods.number_padded)) %></li>
      <% if methods.check_address %>
        <li><%= t(".mail_to") %><div class="check-address"><%= simple_format(methods.check_address) %></div></li>
      <% end %>
      <% if methods.check_dropoff %>
        <li><%= methods.check_dropoff %></li>
      <% end %>
    </ul>
  <% end %>

  <% if methods.pay_with_cash? %>
    <h3><%= t(".cash") %></h3>
    <%= methods.cash_dropoff %>
  <% end %>

  <% if methods.additional_info %>
    <%= safe_render_markdown(methods.additional_info) %>
  <% end %>

  <% if methods.no_payment_instructions? %>
    <%= t(".none_provided") %>
    <% if policy(methods.community).edit? %>
      <%= t(".go_to_settings_html",
            link: link_to(t(".settings_page"), admin_settings_path(type: "community"))) %>
    <% end %>
  <% end %>

  <% if methods.show_billing_contact && methods.billing_contact %>
    <p>
      <%= t(".contact_html",
            email: link_to(methods.billing_contact, "mailto:#{methods.billing_contact}")) %>
    </p>
  <% end %>
</div>
