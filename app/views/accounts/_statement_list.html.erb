<% if statements.any? %>
  <h2 class="inner"><%= t(".statements") %></h2>
  <table class="index statements">
    <tr>
      <th><%= t(".date") %></th>
      <th><%= t(".activity") %></th>
      <th><%= t(".total_due") %></th>
    </tr>
    <%= render("statements/statement_rows") %>
  </table>
<% end %>
