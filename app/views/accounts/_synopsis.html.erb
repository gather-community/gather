<div class="synopsis no-bot-mrg">
  <% if account.balance_due.positive? %>
    <% statement = account.last_statement %>
    <%= icon_tag("warning") %>
    <% if statement.due_on.present? %>
      <%= t(".pay_by", amount: number_to_currency(account.balance_due), date: l(statement.due_on)) %>
    <% else %>
      <%= t(".pay", amount: number_to_currency(account.balance_due)) %>
    <% end %>
  <% elsif account.balance_due.zero? %>
    <%= icon_tag("info-circle") %> <%= t(".zero") %>
  <% else %>
    <%= icon_tag("info-circle") %> <%= t(".credit", amount: number_to_currency(-account.balance_due)) %>
  <% end %>
</div>
