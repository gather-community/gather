<% content_for(:title, t(".title")) %>

<% content_for(:action_links) do %>
  <% if @active_accounts > 0 && @late_fee_count > 0 %>
    <%- concat(link_to(icon_tag("thumbs-down") << " " << t(".apply_late_fees"), apply_late_fees_accounts_path,
      method: :put, class: "btn btn-default",
      data: {controller: "confirm", action: "confirm#check", confirm_message_value: late_fee_confirm})) -%>
  <%- end -%>
  <%- if @statement_accounts -%>
    <%- concat(link_to(icon_tag("paper-plane") << " " << t(".send_statements"), generate_statements_path,
      method: :post, class: "btn btn-primary",
      data: {controller: "confirm", action: "confirm#check", confirm_message_value: statement_confirm_msg})) -%>
  <%- end %>
<% end %>

<% if accounts.empty? %>
  <div class="center-notice">
    <%= t(".no_accounts") %> <%= lenses.no_result_clear_filter_link %>
  </div>
<% else %>
  <p class="subtitle">
    <%= icon_tag("info-circle") %>
    <%= t(".summary", count: @active_accounts) %>
    <%= t(".active_account_definition", count: @active_accounts) %>
  </p>
  <p class="subtitle">
    <%= icon_tag("info-circle") %>
    <% if @last_statement_run.present? %>
      <%= t(".last_statement_run", date: l(@last_statement_run)) %>
    <% else %>
      <%= t(".statements_never_run") %>
    <% end %>
  </p>

  <table class="index">
    <thead>
      <tr>
        <th><%= t(".num") %></th>
        <th><%= t(".household") %></th>
        <th class="amount"><%= t(".last_statement_date") %></th>
        <th class="amount"><%= t(".due_last_statement") %></th>
        <th class="amount"><%= t(".new_credits") %></th>
        <th class="amount"><%= t(".balance_due") %></th>
        <th class="amount"><%= t(".new_charges") %></th>
        <th class="amount"><%= t(".current_balance") %></th>
        <th class="amount"><%= t(".credit_limit") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% accounts.each do |account| %>
        <tr>
          <td>
            <%= account.number_padded %>
          </td>
          <td>
            <%= link_to(account.household_name.html_safe << no_user_warning(account),
              account_path(account)) %>
          </td>
          <td class="amount">
            <%= l(account.last_statement_on) || t("accounts.not_applicable") %>
          </td>
          <td class="amount">
            <%= statement_amount(account.last_statement) %>
          </td>
          <td class="amount">
            <%= link_to_currency_if_nonzero(account.total_new_credits, account_transactions_path(account)) %>
          </td>
          <td class="amount">
            <%= currency_with_cr(account.balance_due) %>
          </td>
          <td class="amount">
            <%= link_to_currency_if_nonzero(account.total_new_charges, account_transactions_path(account)) %>
          </td>
          <td class="amount">
            <strong><%= currency_with_cr(account.current_balance) %></strong>
          </td>
          <td class="amount">
            <%= format_money(account.credit_limit) %>
          </td>
          <td>
            <%= link_to(icon_tag("plus"), new_account_transaction_path(account), title: t(".add_transaction")) %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td></td>
        <td><%= t(".totals") %></td>
        <td></td>
        <td class="amount">
          <%= currency_with_cr(@totals[:due_last_statement]) %>
        </td>
        <td class="amount">
          <%= format_money(@totals[:total_new_credits]) %>
        </td>
        <td class="amount">
          <%= currency_with_cr(@totals[:balance_due]) %>
        </td>
        <td class="amount">
          <%= format_money(@totals[:total_new_charges]) %>
        </td>
        <td class="amount">
          <%= currency_with_cr(@totals[:current_balance]) %>
        </td>
        <td></td>
        <td></td>
      </tr>
    </tfoot>
  </table>

  <footer id="local-footer" class="footer-links">
    <%= icon_tag("download") %> <%= link_to(t(".download_accounts"), accounts_path(format: :csv)) %>
    &nbsp;&nbsp;
    <%= render("transaction_export_form", path: transactions_path(format: :csv)) %>
  </footer>
<% end %>
