<% content_for(:title, t(".title")) %>

<% content_for(:action_links) do %>
  <% if policy(%i[admin domain]).refresh? %>
    <%= button_to(refresh_admin_domains_path, class: "btn btn-primary",
          form: {style: "display:inline-block"}) do %>
      <%= icon_tag("refresh") %> <%= t(".refresh_all") %>
    <% end %>
  <% end %>
<% end %>

<p>
  <%= t(".intro") %>
</p>

<% unless @smtp2go_configured %>
  <div class="alert alert-warning">
    <%= t(".not_configured") %>
  </div>
<% end %>

<% if @report.statuses.empty? %>
  <div class="center-notice">
    <%= t(".none_found") %>
  </div>
<% else %>
  <p>
    <%= t(".summary", count: @report.statuses.size, ok: @report.all_correct_count) %>
    <% unless @report.any_checked? %>
      <%= t(".never_checked_prompt") %>
    <% end %>
  </p>
  <table class="index">
    <thead>
      <tr>
        <th><%= t(".headers.domain") %></th>
        <th><%= t(".headers.communities") %></th>
        <th><%= t(".headers.mx") %></th>
        <th><%= t(".headers.spf") %></th>
        <th><%= t(".headers.smtp2go") %></th>
        <th><%= t(".headers.lists") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @report.statuses.each do |status| %>
        <tr class="<%= status.all_correct? ? "success" : "" %>">
          <td><%= link_to(status.domain.name, admin_domain_path(status.domain)) %></td>
          <td title="<%= status.communities.map(&:name).join(", ") %>">
            <%= status.communities.first&.name %>
            <% if status.communities.size > 1 %>
              <span class="text-muted">+<%= status.communities.size - 1 %></span>
            <% end %>
          </td>
          <% if status.checked? %>
            <td class="<%= status.mx_ok? ? "text-success" : "text-danger" %>"
                title="<%= status.mx.map { |pref, host| "#{pref} #{host}" }.join(", ") %>">
              <%= icon_tag(status.mx_ok? ? "check" : "times") %>
              <%= status.mx_ok? ? t(".correct") : t(".incorrect") %>
            </td>
            <td class="<%= status.spf_ok? ? "text-success" : "text-danger" %>" title="<%= status.spf %>">
              <%= icon_tag(status.spf_ok? ? "check" : "times") %>
              <%= status.spf_ok? ? t(".correct") : t(".incorrect") %>
            </td>
            <td class="validation">
              <% if status.validation_records.empty? %>
                <%= t(".smtp2go_statuses.#{status.smtp2go_status}") %>
              <% else %>
                <% status.validation_records.each do |record| %>
                  <% icon = {verified: "check", in_dns: "clock-o", missing: "times"}[record.state] %>
                  <% color = {verified: "text-success", in_dns: "text-warning", missing: "text-danger"}[record.state] %>
                  <span class="validation-record <%= color %>"
                        title="<%= t(".record_titles.#{record.state}", host: record.host, target: record.target) %>">
                    <%= icon_tag(icon) %>
                    <%= t(".record_kinds.#{record.kind}") %>
                  </span>
                <% end %>
              <% end %>
            </td>
          <% else %>
            <td colspan="3" class="text-muted"><%= t(".never_checked") %></td>
          <% end %>
          <td>
            <% if status.domain.group_mailman_lists.any? %>
              <%= status.domain.group_mailman_lists.size %>
            <% else %>
              <span class="text-muted"><%= t(".no_lists") %></span>
            <% end %>
          </td>
          <td>
            <%= button_to(refresh_admin_domain_path(status.domain),
                  class: "btn btn-link", form: {style: "display:inline"},
                  title: t(".refresh_row")) do %>
              <%= icon_tag("refresh") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
