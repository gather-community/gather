<%# One-click switch between a flag's modes: a single form whose buttons each submit a mode. %>
<%= form_with(url: admin_feature_flag_path(flag), method: :patch, class: "feature-flag-mode-switch") do %>
  <div class="btn-group btn-group-sm" role="group"
       aria-label="<%= t("admin.feature_flags.mode_switch_label", name: flag.name) %>">
    <% FeatureFlag::MODES.each do |mode| %>
      <% current = flag.mode == mode %>
      <% current_class = {off: "btn-off", selected_users: "btn-info", everyone: "btn-success"}[mode] %>
      <%= button_tag(t("admin.feature_flags.modes.#{mode}"),
            name: "feature_flag[mode]", value: mode,
            class: ["btn", current ? "#{current_class} active" : "btn-default", "mode-#{mode}"],
            aria: {pressed: current}) %>
    <% end %>
  </div>
<% end %>
