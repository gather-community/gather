<%# Search box plus the list of chosen users. Each chosen user is a hidden user_ids[] field, so
    nothing changes until the form is saved. The blank field lets an emptied list still be sent. %>
<% min_length = Admin::FeatureFlagsController::USER_SEARCH_MIN_LENGTH %>
<div class="user-picker" data-controller="admin--user-picker"
     data-admin--user-picker-url-value="<%= user_search_admin_feature_flags_path %>"
     data-admin--user-picker-min-length-value="<%= min_length %>"
     data-admin--user-picker-too-short-value="<%= t("admin.feature_flags.user_picker.too_short", count: min_length) %>"
     data-admin--user-picker-searching-value="<%= t("admin.feature_flags.user_picker.searching") %>"
     data-admin--user-picker-no-results-value="<%= t("admin.feature_flags.user_picker.no_results") %>"
     data-admin--user-picker-error-value="<%= t("admin.feature_flags.user_picker.error") %>">
  <%= hidden_field_tag("feature_flag[user_ids][]", "", id: nil) %>
  <div class="user-picker-search">
    <div class="input-group">
      <span class="input-group-addon"><%= icon_tag("search") %></span>
      <input type="text" class="form-control" autocomplete="off" spellcheck="false"
             role="combobox" aria-autocomplete="list" aria-expanded="false"
             aria-controls="user-picker-results"
             aria-label="<%= t("admin.feature_flags.user_picker.label") %>"
             placeholder="<%= t("admin.feature_flags.user_picker.placeholder") %>"
             data-admin--user-picker-target="input"
             data-action="input->admin--user-picker#search keydown->admin--user-picker#keydown
                          blur->admin--user-picker#close focus->admin--user-picker#search">
    </div>
    <ul id="user-picker-results" class="user-picker-results" role="listbox" hidden
        data-admin--user-picker-target="results"
        data-action="mousedown->admin--user-picker#preventBlur"></ul>
  </div>
  <ul class="user-picker-chosen" data-admin--user-picker-target="chosen">
    <% users.each do |user| %>
      <%= render("user_picker_item", id: user.id, name: user.full_name,
            details: [user.community.name, user.email].compact_blank.join(" · ")) %>
    <% end %>
  </ul>
  <%# Copied by the JS for each newly chosen user. %>
  <template data-admin--user-picker-target="template">
    <%= render("user_picker_item", id: "", name: "", details: "") %>
  </template>
</div>
