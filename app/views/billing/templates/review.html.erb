<% content_for(:title, t(".title")) %>

<%= t(".intro") %>

<table class="index">
  <thead>
    <tr>
      <th><%= t(".description") %></th>
      <th><%= t(".type") %></th>
      <th><%= t(".amount") %></th>
      <th><%= t(".households") %></th>
    </tr>
  </thead>
  <tbody>
    <% templates.each do |template| %>
      <tr>
        <td class="description"><%= template.description %></td>
        <td class="type"><%= t("transaction_codes.#{template.code}") %></td>
        <td class="amount"><%= number_to_currency(template.value) %></td>
        <td class="amount">
          <%= template.households.map(&:name).join(", ") %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="footnote">
  <%= icon_tag("warning") %>
  <%= t(".outdated_warning") %>
</div>

<%= form_tag(apply_billing_templates_path, class: "footnote") do %>
  <%= hidden_field_tag("ids", templates.map(&:id).join(",")) %>
  <%= form_actions do %>
    <%= button_tag(t(".cancel"), name: "cancel", class: "btn btn-default") %>
    <%= button_tag(t(".apply"), class: "btn btn-primary") %>
  <% end %>
<% end %>
