<% content_for(:title, t(".title")) %>

<% content_for(:action_links) do %>
  <%- if policy(Calendars::Group.new(community: current_community)).create? -%>
    <%- concat(link_to(icon_tag("plus") << " " << t(".create_group"),
      new_calendars_group_path, class: "btn btn-default")) -%>
  <%- end -%>
  <%- if policy(sample_calendar).create? -%>
    <%- concat(link_to(icon_tag("plus") << " " << t(".create_calendar"),
      new_calendar_path, class: "btn btn-primary")) -%>
  <%- end -%>
<% end %>

<% if @calendar_nodes.empty? %>
  <div class="center-notice">
    <%= t(".no_calendars") %>
  </div>
<% else %>
  <%= render("table") %>
<% end %>

<%= javascript_tag do %>
  $(function() {
    new Gather.Views.Calendars.IndexView({el: '.calendars--calendars'});
  });
<% end %>
