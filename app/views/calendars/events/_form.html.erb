<%= gather_form_for(@form, url: @form.url, html: {data: {controller: "calendars--event-form",
  "calendars--event-form-community-id-value": event.community_id}}) do |f| %>

  <%= f.hidden_field :calendar_id %>
  <%= f.hidden_field :origin_page %>
  <% if @form.series_edit? %>
    <%= f.hidden_field :occurrence_start, value: @form.occurrence_start.to_i %>
  <% end %>
  <%= f.input :calendar do %>
    <%= image_tag(calendar.photo_variant(:thumb), alt: calendar.name) %><br/>
    <%= calendar.name %>
  <% end %>

  <% event.rules(rule_name: :pre_notice, kind: :any).each do |rule| %>
    <%# Include rule kinds as data attrib so these can be shown/hidden appropriately. %>
    <% data = rule.kinds.present? ? {kinds: rule.kinds.map { |k| "{#{k}}" }.join, "calendars--event-form-target": "kindNotice"} : nil %>
    <%= f.input :pre_notice, label: "", wrapper_html: {data: data} do %>
      <%= Calendars::Rules::PreNoticeRuleDecorator.new(rule).alert_tag %>
    <% end %>
  <% end %>

  <% unless @rule_set.timed_events_only? %>
    <%= f.input :all_day, as: :boolean, input_html: {data: {"calendars--event-form-target": "allDay",
      action: "calendars--event-form#allDayChanged"}} %>
  <% end %>

  <% unless event.meal? %>
    <%= f.input :name, maxlength: Calendars::EventForm::NAME_MAX_LENGTH %>
  <% end %>

  <% if policy(event).choose_creator? %>
    <%= f.input :creator_id, as: :user_select, context: event.creator_select2_context %>
  <% end %>

  <% unless event.meal? %>
    <%= f.input :group_id, collection: @groups %>
  <% end %>

  <%= f.input :starts_at, as: :datetime_picker, include_day_of_week: true,
    wrapper_html: { class: event.fixed_start_time? ? "no-time-picker" : "" } %>

  <%= f.input :ends_at, as: :datetime_picker, include_day_of_week: true,
    wrapper_html: { class: event.fixed_end_time? ? "no-time-picker" : "" } %>

  <%= render("repeat_fields", f: f) %>

  <% unless event.meal? %>
    <% if @kinds.present? && event.requires_kind? %>
      <%= f.input :kind, collection: @kinds, required: true, input_html: {data: {"calendars--event-form-target": "kind",
        action: "calendars--event-form#kindChanged"}} %>
    <% end %>

    <% if event.access_level(current_user.community) == "sponsor" %>
      <%= f.input :sponsor_id, as: :user_select, context: "current_community_full_access", required: true %>
    <% end %>
  <% end %>

  <%= f.input :note, as: :markdown %>

  <%# Meal events are only ever edited, so there is no need for this. It would always be checked. %>
  <% if calendar.guidelines? && !event.meal? %>
    <%= f.input :guidelines, required: true do %>
      <div id="guidelines">
        <%= safe_render_markdown(calendar.all_guidelines) %>
      </div>
      <label>
        <%= f.check_box(:guidelines_ok) %>
        <strong><%= t(".agree_to_guidelines") %></strong>
      </label>
    <% end %>
  <% end %>

  <%= form_actions do %>
    <%= f.button :primary %>
  <% end %>
<% end %>
