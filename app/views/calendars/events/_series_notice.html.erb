<%# For a repeating event, opened from one of its occurrences, which occurrences the form changes. %>
<% upcoming = @form.first_upcoming_occurrence %>
<% upcoming_link = upcoming && link_to(l(upcoming.to_date), edit_calendars_event_path(event,
     occurrence: upcoming.to_i, origin_page: @form.origin_page)) %>
<% if !@form.editable? %>
  <div class="alert alert-warning">
    <%= t(".started") %>
    <%= t(".edit_later_html", link: upcoming_link) if upcoming_link %>
  </div>
<% elsif @form.applies_from_opened? %>
  <div class="alert alert-info">
    <%= t(".applies_from", date: l(@form.occurrence_start.to_date)) %>
    <%= t(".edit_earlier_html", link: upcoming_link) if upcoming && upcoming < @form.occurrence_start %>
  </div>
<% end %>
