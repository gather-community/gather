<p>The following error(s) occurred in trying to save your changes:</p>
<ul>
  <% errors.sort_by { |e| e.attribute == :base ? 0 : 1 }.each do |error| %>
    <% attrib = error.attribute == :base ? nil : Calendars::EventForm.human_attribute_name(error.attribute) %>
    <li><%= [attrib, error.message].compact.join(": ") %></li>
  <% end %>
</ul>
