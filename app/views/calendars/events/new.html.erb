<% if calendar %>
  <% content_for(:title, t(".title", calendar: calendar.name)) %>
  <%= render("form") %>
  <br/><br/>
<% elsif calendars.empty? %>
  <% content_for(:title, t(".no_calendars_title")) %>
  <%= t(".no_calendars") %>
  <% if @can_create_calendar %>
    <%= link_to(t(".create_one"), calendars_calendars_path) %>
  <% end %>
<% else %>
  <% content_for(:title, t(".select_calendar")) %>
  <% calendars.each do |calendar| %>
    <div class="calendar">
      <%= link_to(new_calendar_event_path(calendar, @url_params)) do %>
        <%= image_tag(calendar.photo_variant(:thumb), alt: calendar.name) %>
        <%= calendar.name_with_inactive %>
      <% end %>
    </div>
  <% end %>
<% end %>
