<% content_for(:title, t(".title")) %>
<% decorator = Calendars::ExportDecorator.new(current_community, current_user) %>

<div class="calendars-and-url">
  <section class="calendar-list-wrapper">
    <h2 class="top"><%= t(".select_calendars") %></h2>
    <%= render("calendars/calendar_list", nodes: @calendars) %>
  </section>
  <section class="export-url-and-options">
    <h2 class="top"><%= t(".export_link") %></h2>

    <%= simple_form_for(:calendars_export) do |f| %>
      <input type="text" id="export-url" readonly/>
      <div class="sub-links">
        <a href="#" id="copy-link"><%= t(".copy_link") %></a>&nbsp;&nbsp;&nbsp;
        <a href="#" id="visit-link"><%= t(".visit_link") %></a>
      </div>
      <small class="details">
        <span class="personalized">
          <%= t(".personalized") %>
        </span>
        <%= t(".selection_changes_link") %>
      </small>
      <div class="options">
        <h3><%= t(".options") %></h3>
        <%= f.input(:dont_personalize, as: :boolean) %>
        <%= f.input(:own_only, as: :boolean) %>
      </div>
    <% end %>

    <h2><%= t(".import_instructions") %></h2>

    <h3><%= icon_tag("brands google") %> <%= t(".google_calendar") %></h3>
    <h4><%= t(".method_1") %></h4>
    <%= t(".google_method_1") %>
    <h4><%= t(".method_2") %></h4>
    <ol>
      <% t(".google_steps").each do |step| %>
        <li><%= step %></li>
      <% end %>
    </ol>

    <h3><%= icon_tag("apple") %> <%= t(".apple_calendar") %></h3>
    <h4><%= t(".method_1") %></h4>
    <%= t(".apple_method_1") %>
    <h4><%= t(".method_2") %></h4>
    <ol>
      <% t(".apple_steps").each do |step| %>
        <li><%= step %></li>
      <% end %>
    </ol>
  </section>
</div>

<div class="footnote">
  <%= t(".reset_token_html",
        link: link_to(t(".reset_token_link"), calendars_exports_reset_token_path, method: :put)) %>
</div>

<%= javascript_tag do %>
  $(function() {
    var listView = new Gather.Views.Calendars.CalendarListView({
      el: '.calendar-list-wrapper',
      selection: <%= json(@calendar_selection) %>,
      dontPersist: true,
      communityId: <%= json(current_community&.id) %>
    });
    new Gather.Views.Calendars.ExportView({
      el: '.calendars-and-url',
      listView: listView,
      rootUrl: <%= json(root_url) %>,
      userToken: <%= json(current_user.calendar_token) %>,
      communityToken: <%= json(current_community.calendar_token) %>
    });
  });
<% end %>
