<div class="calendar-slot-row">
  <div class="calendar-slot-fields">
    <%# Hidden _destroy flag — Stimulus sets this to "1" when the remove button is clicked. %>
    <%= f.hidden_field :_destroy %>

    <%= f.input :calendar_id,
      collection: @writeable_calendars,
      label_method: :name,
      value_method: :id,
      include_blank: true,
      input_html: {data: {"action" => "change->calendars--multi-event-form#calendarChanged"}} %>

    <%= f.input :customize_times, as: :boolean,
      input_html: {data: {"action" => "change->calendars--multi-event-form#customizeTimesChanged"}} %>

    <div class="customize-times-fields <%= "hidden" unless f.object&.customize_times? %>">
      <%= f.input :starts_at, as: :time_picker %>
      <%= f.input :ends_at, as: :time_picker %>
    </div>
  </div>

  <div class="remove-link-col">
    <button type="button"
            class="btn btn-link remove-calendar-btn"
            aria-label="Remove calendar"
            data-action="click->calendars--multi-event-form#removeSlot">
      <%= icon_tag("trash") %>
    </button>
  </div>
</div>
