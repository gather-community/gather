<% content_for(:title, t(".title")) %>

<% content_for(:action_links) do %>
  <% if policy(sample_protocol).create? %>
    <%= link_to(icon_tag("plus") << " " << t(".create"),
      new_calendars_protocol_path, class: "btn btn-primary") %>
  <% end %>
<% end %>

<% if protocols.empty? %>
  <div class="center-notice">
    <%= t(".no_protocols") %>
  </div>
<% else %>
  <table class="index">
    <tr>
      <th><%= t(".name") %></th>
      <th><%= t(".calendars") %></th>
      <% if @kinds_present %>
        <th><%= t(".types") %></th>
      <% end %>
      <th><%= t(".rules") %></th>
    </tr>
    <% protocols.each do |protocol| %>
      <tr>
        <td class="name">
          <%= link_to(protocol.name, edit_calendars_protocol_path(protocol)) %>
        </td>
        <td>
          <%= protocol.calendar_names %>
        </td>
        <% if @kinds_present %>
          <td>
            <%= protocol.kinds&.join(", ") %>
          </td>
        <% end %>
        <td>
          <%= protocol.defined_rules %>
        </td>
      </tr>
    <% end %>
  </table>
<% end %>
