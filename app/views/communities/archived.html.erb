<% content_for(:title, "Community Archived") %>

<div class="page-header">
  <h1><%= current_community.name %> has been archived</h1>
</div>

<p>
  This community was archived on <%= l(current_community.archived_at.to_date) %> due to prolonged inactivity
  and is no longer accessible.
</p>

<p>
  If you believe this is an error or would like to restore your community, please contact
  <%= mail_to("support@gather.coop") %>.
</p>
