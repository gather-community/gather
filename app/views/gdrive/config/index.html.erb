<% content_for(:title) { t(".title") } %>

<% content_for(:action_links) do %>
  <% if !@auth_required %>
    <% if @migration_operation %>
      <% if policy(@migration_operation).show? %>
        <%= link_to(icon_tag("truck") << " " << t(".migration"), gdrive_migration_dashboard_home_path, class: "btn btn-default") %>
      <% end %>
    <% else %>
      <% if policy(sample_operation).new? %>
        <%= link_to(icon_tag("truck") << " " << t(".migrate_files"), new_gdrive_migration_operation_path, class: "btn btn-default") %>
      <% end %>
    <% end %>
    <% if policy(sample_item).create? %>
      <%= link_to(icon_tag("plus") << " " << t(".link_item"), new_gdrive_item_path, class: "btn btn-primary") %>
    <% end %>
  <% end %>
<% end %>

<% if @auth_required %>
  <% if @config.new_record? %>
    <h2><%= t(".credentials") %></h2>
    <p>
      <%= t(".add_credentials_html", link: link_to(t(".config_guide"), gdrive_guide_path)) %>
    </p>
    <%= render("config_form") %>
  <% else %>
    <h2><%= t(".authentication") %></h2>
    <p>
      <% if @config.items.any? %>
        <%= t("gdrive.browse.index.reconnect") %>
      <% else %>
        <%= t("gdrive.browse.index.not_connected") %>
      <% end %>
      <%= t("gdrive.browse.index.authenticate_as_html", user: tag.strong(@config.org_user_id)) %>
    </p>
    <%= render("gdrive/browse/auth_button") %>

    <h2><%= t(".credentials") %></h2>
    <p><%= t(".update_credentials") %></p>
    <%= render("config_form") %>
  <% end %>
<% else %>
  <section aria-label="<%= t(".introduction") %>">
    <p>
      <%= t(".system_user_html", user: @config.org_user_id) %>
    </p>
    <p>
      <%= t(".intro_html", link: link_to(t(".browse_page"), gdrive_home_path)) %>
    </p>
  </section>

  <table class="full-width">
    <% %i[drive folder file].each do |kind| items = @items_by_kind[kind] %>
      <tr class="heading">
        <td colspan="4">
          <h2><%= t("gdrive.item_kinds.#{kind}", count: 2) %></h2>
        </td>
      </tr>
      <% if items.any? %>
        <tr>
          <th><%= t(".name") %></th>
          <th><%= t(".status") %></th>
          <th><%= t(".groups_permissions") %></th>
          <th></th>
        </tr>
        <% items.each do |item| %>
          <tr>
            <td><%= item.name.presence || "[#{item.external_id.truncate(32)}]" %></td>
            <td>
              <% if item.error_type %>
                <%= icon_tag("times-circle", class: "status bad") %> &nbsp;
                <%= t("gdrive.item_error_types.#{item.error_type}") %>
              <% else %>
                <%= icon_tag("check-circle", class: "status good") %>
              <% end %>
            </td>
            <td>
              <% item.item_groups.each do |item_group| %>
                <div>
                  <%= link_to(item_group.group.name, item_group.group) %>:
                  <%= t(".access_level", level: t("gdrive.access_levels.#{item_group.access_level}"),
                        hint: t("gdrive.access_level_hints.#{item_group.access_level}")) %>&nbsp;
                  <%= link_to(icon_tag("times"), gdrive_item_group_path(item_group),
                        method: :delete,
                        data: {controller: "confirm", action: "confirm#check",
                               confirm_message_value: I18n.t("confirmations.gdrive/item_group.destroy")}) %>
                </div>
              <% end %>
              <%= link_to(icon_tag("plus") << " " << t(".add_group"), new_gdrive_item_group_path(item_id: item.id)) %>
            </td>
            <td>
              <%= link_to(icon_tag("trash"), gdrive_item_path(item),
                    method: :delete,
                    data: {controller: "confirm", action: "confirm#check",
                           confirm_message_value: I18n.t("confirmations.gdrive/item.destroy")}) %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr class="heading">
          <td colspan="4">
            <%= t(".none_linked.#{kind}") %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </table>

  <footer id="local-footer" class="footer-links">
    <% unless @auth_required %>
      <%= t(".revoke_html", link: link_to(t(".revoke"), gdrive_setup_auth_revoke_path, method: :delete,
            data: {controller: "confirm", action: "confirm#check", confirm_message_value: t(".revoke_confirm")})) %>
    <% end %>
  </footer>
<% end %>