<% if @latest_scan.nil? %>
  <%= t(".not_begun_contact") %>
<% elsif @latest_scan.new? %>
  <%= t(".not_begun_wait") %>
<% elsif @latest_scan.in_progress? %>
  <%= t(".in_progress", count: number_with_delimiter(@latest_scan.scanned_file_count)) %>
<% elsif @latest_scan.complete? %>
  <%= t(".complete") %>
<% elsif @latest_scan.cancelled? %>
  <% case @latest_scan.cancel_reason %>
  <% when "auth_error" %>
    <%= t(".auth_error_html", user: @config.org_user_id,
          folder_link: link_to(t(".source_folder"), "https://drive.google.com/drive/u/0/folders/#{@operation.src_folder_id}"),
          home_link: link_to(t(".main_page"), gdrive_home_path)) %>
  <% when "too_many_errors" %>
    <%= t(".too_many_errors") %>
  <% else %>
    <%= t(".cancelled_unknown") %>
  <% end %>
<% else %>
  <%= t(".unknown_state") %>
<% end %>