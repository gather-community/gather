<%= t(".dear", name: @name) %>

<%= t(".using_gather", community: @community.name) %>

<%= t(".problem") %>

<%= t(".solution") %>

<% if @migration_request.file_count >= 2 %>
<%= t(".own_many", email: @migration_request.google_email, count: @migration_request.file_count, community: @community.name) %>
<% else %>
<%= t(".own_one", email: @migration_request.google_email, community: @community.name) %>
<% end %>

<%= t(".go_here", url: gdrive_migration_request_url(token: @migration_request.token)) %>

<%= t(".retain_access", contact: @operation.contact_name, email: @operation.contact_email) %>

<%= t(".thanks") %>
