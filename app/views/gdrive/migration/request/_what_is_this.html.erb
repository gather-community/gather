<p>
  <%= t(".using_gather_html", community: @community.name) %>
</p>
<p>
  <%= t(".problem") %>
</p>
<p>
  <%= t(".solution") %>
</p>
<p class="cta">
  <% if migration_request.file_count >= 2 %>
    <%= t(".own_many_html", count: migration_request.file_count, community: @community.name,
          link: link_to(t(".old_folder"), @operation.src_folder_url)) %>
  <% else %>
    <%= t(".own_one_html", community: @community.name, link: link_to(t(".old_folder"), @operation.src_folder_url)) %>
  <% end %>
</p>
<p>
  <%= t(".retain_access") %>
</p>
<p>
  <%= t(".questions_html", contact: link_to(@operation.contact_name, "mailto:#{@operation.contact_email}")) %>
</p>
<p>
  <%= t(".opt_out_html", link: link_to(t(".opt_out"), gdrive_migration_request_opt_out_path)) %>
</p>