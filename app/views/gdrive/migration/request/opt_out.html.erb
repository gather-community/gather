<% content_for(:title, t("gdrive.migration.request.title", community: current_community.name)) %>
<div class="simple">
  <h2><%= t(".heading") %></h2>
  <% if !migration_request.active? %>
    <p><%= t(".not_active") %></p>
  <% else %>
    <% if @untransferred_files.none? %>
      <p>
        <%= t(".why") %>
      </p>
    <% else %>
      <p>
        <%= t(".still_own") %>
      </p>
     <% end %>
    <p>
      <%= t(".went_wrong") %>
    </p>
    <p>
      <%= t(".didnt_mean_html", link: link_to(t(".go_back_link"), gdrive_migration_request_path)) %>
    </p>
    <%= gather_form_for(migration_request, url: gdrive_migration_request_confirm_opt_out_path, html: {class: "full-width"}) do |f| %>
      <%= f.input(:opt_out_reason) %>
      <%= form_actions do %>
        <%= link_to(t(".go_back"), gdrive_migration_request_path) %>
        <%= f.button :primary, :opt_out %>
      <% end %>
    <% end %>

    <% if @untransferred_files.any? %>
      <h3><%= t(".not_transferred") %></h3>
      <table class="full-width">
        <tr>
          <th><%= t(".name") %></th>
          <th><%= t(".modified") %></th>
        </tr>
        <% @untransferred_files.each do |file| %>
          <tr>
            <td>
              <%= image_tag(file.icon_link, class: "file-icon", alt: t(".file_icon")) %>
              <%= link_to(file.name, file.web_view_link, target: "_blank") %>
            </td>
            <td><%= I18n.l(file.modified_at, format: :day_mo_yr_no_time) %></td>
          </tr>
        <% end %>
      </table>
      <%= gather_paginate(@untransferred_files) %>
    <% end %>
  <% end %>
</div>