<% content_for(:title, t("gdrive.migration.request.title", community: @community.name)) %>

<div class="simple">
  <h2><%= t(".heading") %></h2>
  <p>
    <%= t(".view_files", community: @community.name) %>
  </p>
  <p><%= link_to(t(".view_files_button"), migration_request.owned_files_url,
        class: "btn btn-primary", target: "_blank") %></p>
  <p>
    <%= t(".see_something_like") %>
  </p>
  <p>
    <%= image_tag("gdrive/migration/request/step1-1.png", class: "screenshot") %>
  </p>
  <p class="wizard-buttons">
    <%= link_to(t("gdrive.migration.request.previous"), gdrive_migration_request_path, class: "btn btn-default") %>
    <%= link_to(t("gdrive.migration.request.next"), gdrive_migration_request_step2_path, class: "btn btn-primary") %>
  </p>
  <h2 class="troubleshooting"><%= t("gdrive.migration.request.troubleshooting") %></h2>
  <h3><%= t(".no_files") %></h3>
  <p>
    <%= t(".no_files_help_html", email: tag.b(migration_request.google_email)) %>
  </p>
</div>
