<% content_for(:title, t("gdrive.migration.request.title", community: @community.name)) %>

<div class="simple">
  <h2><%= t(".heading") %></h2>
  <p><%= t(".select") %></p>
  <p>
    <%= t(".easiest") %>
    <ol>
      <li><%= t(".click_first") %></li>
      <li><%= t(".go_to_end") %></li>
      <li><%= t(".shift_click_html") %></li>
    </ol>
  </p>
  <p>
    <%= t(".see_something_like") %>
  </p>
  <p>
    <%= image_tag("gdrive/migration/request/step2-1.png", class: "screenshot") %>
  </p>
  <p class="wizard-buttons">
    <%= link_to(t("gdrive.migration.request.previous"), gdrive_migration_request_step1_path, class: "btn btn-default") %>
    <%= link_to(t("gdrive.migration.request.next"), gdrive_migration_request_step3_path, class: "btn btn-primary") %>
  </p>
  <h2 class="troubleshooting"><%= t("gdrive.migration.request.troubleshooting") %></h2>
  <h3><%= t(".one_at_a_time") %></h3>
  <p>
    <%= t(".holding_html") %>
  </p>
  <p>
    <%= t(".shift_explained") %>
  </p>
</div>
