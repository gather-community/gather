<% content_for(:title, t("gdrive.migration.request.title", community: @community.name)) %>

<div class="simple">
  <h2><%= t(".heading") %></h2>
  <p>
    <%= t(".click_sequence") %>
    <ol>
      <li><%= t(".dots") %></li>
      <li><%= t(".organize") %></li>
      <li><%= t(".move") %></li>
    </ol>
  </p>
  <p>
    <%= image_tag("gdrive/migration/request/step3-1.gif", class: "screenshot") %>
  </p>
  <p class="wizard-buttons">
    <%= link_to(t("gdrive.migration.request.previous"), gdrive_migration_request_step2_path, class: "btn btn-default") %>
    <%= link_to(t("gdrive.migration.request.next"), gdrive_migration_request_step4_path, class: "btn btn-primary") %>
  </p>
</div>
