<% content_for(:title, t("gdrive.migration.request.title", community: @community.name)) %>

<div class="simple">
  <h2><%= t(".heading") %></h2>
  <p>
    <ol>
      <li><%= t(".all_locations") %></li>
      <li><%= t(".shared_drives") %></li>
      <li><%= t(".next_to_html", drive: tag.strong(migration_request.file_drop_drive_name)) %></li>
      <li><%= t(".move_button") %></li>
    </ol>
  </p>
  <p>
    <%= image_tag("gdrive/migration/request/step4-1.gif", class: "screenshot") %>
  </p>
  <p class="wizard-buttons">
    <%= link_to(t("gdrive.migration.request.previous"), gdrive_migration_request_step3_path, class: "btn btn-default") %>
    <%= link_to(t("gdrive.migration.request.next"), gdrive_migration_request_step5_path, class: "btn btn-primary") %>
  </p>
  <h2 class="troubleshooting"><%= t("gdrive.migration.request.troubleshooting") %></h2>
  <h3><%= t(".no_shared_drives") %></h3>
  <p>
    <%= t(".signed_in_html", email: tag.b(migration_request.google_email),
          link: link_to(t(".this_link"), migration_request.file_drop_drive_url, target: "_blank")) %>
  </p>
  <p>
    <%= t(".still_trouble_html", contact: link_to(@operation.contact_name, "mailto:#{@operation.contact_email}")) %>
  </p>
  <h3><%= t(".unselected") %></h3>
  <p>
    <%= t(".go_back_html", link: link_to(t(".step2"), gdrive_migration_request_step2_path)) %>
  </p>
  <h3><%= t(".ownership") %></h3>
  <p>
    <%= t(".ownership_explained", community: @community.name) %>
  </p>
  <p>
    <%= t(".still_access") %>
  </p>
</div>
