<% content_for(:title, t("gdrive.migration.request.title", community: @community.name)) %>

<div class="simple">
  <h2><%= t(".heading") %></h2>
  <p><%= t(".empty_list") %></p>
  <p>
    <%= image_tag("gdrive/migration/request/step5-1.png", class: "screenshot") %>
  </p>
  <p>
    <%= t(".done") %>
  </p>
  <p class="wizard-buttons">
    <%= link_to(t("gdrive.migration.request.previous"), gdrive_migration_request_step4_path, class: "btn btn-default") %>
    <%= link_to(t(".finish"), gdrive_migration_request_finish_path, class: "btn btn-primary") %>
  </p>
  <h2 class="troubleshooting"><%= t("gdrive.migration.request.troubleshooting") %></h2>
  <h3><%= t(".not_empty") %></h3>
  <p>
    <%= t(".head_back_html", link: link_to(t(".step2"), gdrive_migration_request_step2_path)) %>
  </p>
  <h3><%= t(".some_files") %></h3>
  <p>
    <%= t(".use_opt_out_html", link: link_to(t(".opt_out_form"), gdrive_migration_request_opt_out_path)) %>
  </p>
</div>
