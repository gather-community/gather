<tr>
  <td><%= t(".unit") %></td>
  <td><%= household.unit_num.nil? ? t("common.none_bracketed") : t("households.number", number: household.unit_num_and_suffix) %></td>
</tr>
<% if multi_community? %>
  <tr>
    <td><%= t(".community") %></td>
    <td><%= household.community_name %></td>
  </tr>
<% end %>
