<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="ltr">
<head>
  <title>Gather</title> <%# erb_lint:disable HardCodedText %>
  <%= render("layouts/head") %>
</head>
<body class="landing">
  <%= flash_messages %>
  <main>
    <h1 id="blurb"><%= t(".blurb") %></h1>
    <%= image_tag("logo-white.png", id: "logo", alt: t(".logo_alt")) %>
    <div id="sign-in-btns">
      <%= link_to(icon_tag("brands google") << " " << t(".sign_in_google"),
            user_google_oauth2_omniauth_authorize_url(host: Settings.url.host, state: @invite_token),
            method: :post, id: "sign-in-btn", class: "btn btn-primary") %>
      <% if @invite_token %>
        <%= link_to(icon_tag("asterisk") << " " << t(".sign_in_password"),
              edit_user_password_url(host: Settings.url.host, reset_password_token: @invite_token),
              id: "sign-in-btn", class: "btn btn-primary") %>
      <% else %>
        <%= link_to(icon_tag("asterisk") << " " << t(".sign_in_password"),
              new_user_session_url(host: Settings.url.host),
              id: "sign-in-btn", class: "btn btn-primary") %>
      <% end %>
    </div>
    <div id="help-links">
      <div>
        <%= link_to(icon_tag("info-circle") << " " << t(".learn_more"), "http://info.gather.coop") %>
      </div>
      <div>
        <%= link_to(icon_tag("rocket") << " " << t(".try_it_out"), new_communities_signup_path) %>
      </div>
    </div>
  </main>
  <%= render("layouts/footer") %>
</body>
</html>
