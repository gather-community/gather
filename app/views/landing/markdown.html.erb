<% content_for(:title, t(".title")) %>

<div class="markdown-demo">
  <p><%= t(".intro_html") %></p>

  <%# Each example is shown as typed, then rendered by the same Markdown renderer the rest of Gather uses. %>
  <% %w[formatting lists headers tables links images rule html].each_with_index do |example, i| %>
    <% source = t(".examples.#{example}") %>
    <div class="row">
      <div class="markdown">
        <% if i.zero? %><em><%= t(".if_you_type") %></em><% end %>
        <pre><%= source %></pre>
      </div>
      <div class="html">
        <% if i.zero? %><em><%= t(".displayed_like") %></em><% end %>
        <%= safe_render_markdown(source) %>
      </div>
    </div>
  <% end %>
  <p><%= t(".outro") %></p>
</div>
