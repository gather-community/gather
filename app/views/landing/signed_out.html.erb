<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="ltr">
<head>
  <title><%= t(".title") %></title>
  <%= render("layouts/head") %>
</head>
<body class="landing signed-out">
  <div class="row">
    <div class="col-sm-6 col-sm-offset-3">
      <%= icon_tag("sign-out") %>
      <p><%= t(".signed_out") %></p>
      <br/>
      <p>
        <%= t(".public_computer_html", link: link_to(t(".google_sign_out"),
              "https://accounts.google.com/logout?continue=https://google.com")) %>
      </p>
      <br/>
      <p>
        <%= link_to(t(".return_home"), root_path) %>
      </p>
    </div>
  </div>
</body>
</html>
