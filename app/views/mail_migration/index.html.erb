<% content_for(:title, t(".title")) %>

<p>
  <%= t(".intro") %>
</p>

<% if @report.smtp2go_error %>
  <div class="alert alert-warning">
    <%= t(".smtp2go_errors.#{@report.smtp2go_error}") %>
  </div>
<% end %>

<% if @report.statuses.empty? %>
  <div class="center-notice">
    <%= t(".none_found") %>
  </div>
<% else %>
  <p>
    <%= t(".summary", count: @report.statuses.size, migrated: @report.migrated_count) %>
  </p>
  <table class="index">
    <thead>
      <tr>
        <th><%= t(".headers.domain") %></th>
        <th><%= t(".headers.communities") %></th>
        <th><%= t(".headers.sending_via") %></th>
        <th><%= t(".headers.mx") %></th>
        <th><%= t(".headers.spf") %></th>
        <th><%= t(".headers.smtp2go") %></th>
        <th><%= t(".headers.validation_records") %></th>
      </tr>
    </thead>
    <tbody>
      <% @report.statuses.each do |status| %>
        <tr class="<%= status.migrated? ? "success" : "" %>">
          <td><%= status.domain.name %></td>
          <td><%= status.communities.map(&:name).join(", ") %></td>
          <td><%= t(".sending_via.#{status.sending_via}") %></td>
          <td class="<%= status.mx_ok? ? "text-success" : "text-danger" %>"
              title="<%= status.mx.map { |pref, host| "#{pref} #{host}" }.join(", ") %>">
            <%= icon_tag(status.mx_ok? ? "check" : "times") %>
            <%= status.mx_ok? ? t(".updated") : t(".not_updated") %>
          </td>
          <td class="<%= status.spf_ok? ? "text-success" : "text-danger" %>" title="<%= status.spf %>">
            <%= icon_tag(status.spf_ok? ? "check" : "times") %>
            <%= status.spf_ok? ? t(".updated") : t(".not_updated") %>
          </td>
          <td><%= t(".smtp2go_statuses.#{status.smtp2go_status}") %></td>
          <td>
            <% if status.validation_records.empty? %>
              <%= t(".no_validation_records") %>
            <% else %>
              <% status.validation_records.each do |record| %>
                <div class="<%= record.in_dns ? "text-success" : "text-danger" %>"
                     title="<%= t(".record_points_to", host: record.host, target: record.target) %>">
                  <%= icon_tag(record.in_dns ? "check" : "times") %>
                  <%= t(".record_kinds.#{record.kind}") %>
                </div>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
