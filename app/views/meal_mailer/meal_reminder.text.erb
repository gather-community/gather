<%= @household.greeting %>

<% if @meal.location_name -%>
<%= t(".reminder_at_location", title: @meal.title_or_no_title, date: @meal.served_at_wday_no_year, location: @meal.location_name) %>
<% else -%>
<%= t(".reminder", title: @meal.title_or_no_title, date: @meal.served_at_wday_no_year) %>
<% end -%>

<%= t("meal_mailer.meal_reminder.body.diner_count", count: @signup.total) %><% if @signup.comments.present? %> <%= t(".comments_intro") %>
--------------
<%= @signup.comments %>
--------------
<% else %>

<% end %>

<% if @assigns.any? -%>
<%= t(".staff") %>

<% @assigns.each do |a| -%>
<%= t(".staff_member", role: a.role_title, name: a.user.name) %>
<% end -%>
<% end %>

<%= render("meal_link") -%>

<%= t(".bon_appetit") %>
