<%= @user.greeting %>

<%= t(".scheduled", role: @assignment.role_title, title: @meal.title_or_no_title, date: @meal.served_on_no_yr) %>

<% if @meal.location_name -%>
<%= t(".shift_at_location", times: @assignment.date_or_times, location: @meal.location_name, time: @meal.served_at_time_only) %>
<% else -%>
<%= t(".shift", times: @assignment.date_or_times, time: @meal.served_at_time_only) %>
<% end -%>
<% if @reminder.note? %>

<%= t(".note_intro") %>
--------------
<%= @reminder.note %>
--------------
<% end %>

<%= t(".crucial") %>

<%= t(".contacts_intro") %>

<% @other_assigns.each do |a| -%>
<%= t(".contact", role: a.role_title, name: a.user.name, email: a.user.email, phones: a.user.phone_list) %>
<% end %>

<%= render("meal_link") %>
