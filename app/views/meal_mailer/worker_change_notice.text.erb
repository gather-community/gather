<% if @meal.location_name -%>
<%= t(".intro_at_location", name: @initiator.name, title: @meal.title_or_no_title, date: @meal.served_at_wday_no_year, location: @meal.location_name) %>
<% else -%>
<%= t(".intro", name: @initiator.name, title: @meal.title_or_no_title, date: @meal.served_at_wday_no_year) %>
<% end -%>

<% if @added.any? -%>
<% @added.each do |a| -%>
<%= t(".added", name: a.user.name, role: a.role_title) %>
<% end -%>
<% end -%>
<% if @removed.any? -%>
<% @removed.each do |a| -%>
<%= t(".removed", name: a.user.name, role: a.role_title) %>
<% end -%>
<% end -%>

<%= render("meal_link") %>

<%= t(".thanks") %>
