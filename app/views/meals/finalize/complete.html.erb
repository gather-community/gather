<% content_for(:title, t("meals.finalize.title", title: @meal.title || t("meals.finalize.untitled"))) %>

<div class="center-notice">
  <p><%= t(".success") %></p>
  <% case cost.payment_method %>
  <% when "check" %>
    <%= t(".check", name: cost.reimbursee.name, amount: cost.ingredient_cost_formatted) %>
  <% when "credit" %>
    <%= t(".credit", name: cost.reimbursee.name, amount: cost.ingredient_cost_formatted) %>
  <% when "paypal" %>
    <%= t(".paypal", amount: cost.ingredient_cost_formatted, email: cost.reimbursee.paypal_email_or_default) %>
  <% end %>
</div>
