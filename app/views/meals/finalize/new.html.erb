<% content_for(:title, t("meals.finalize.title", title: @meal.title || t("meals.finalize.untitled"))) %>

<%= render("meals/meals/time_cook") %>

<%= gather_form_for(@meal, name: "finalize", url: meal_finalize_path, method: :post) do |f| %>
  <%= render("meals/meals/form/signups", f: f, expanded: true) %>
  <%= render("meals/meals/form/expenses", f: f, expanded: true) %>
  <%= form_actions do %>
    <%= f.button :primary, :continue %>
  <% end %>
<% end %>

<script>
  $(function() {
    new Gather.Views.AjaxSelect2({el: '.finalize-form'});
    new Gather.Views.DirtyChecker({el: '.finalize-form'});
  });
</script>
