<h2><%= t(".data_format") %></h2>

<p>
  <%= t(".use_columns") %>
</p>

<table class="key-value">
  <tr>
    <td><%= t("csv.headers.meals/meal.served_at") %></td>
    <td><%= t(".served_at") %></td>
  </tr>
  <tr>
    <td><%= t("csv.headers.meals/meal.calendars") %></td>
    <td><%= t(".calendars_html", link: link_to(t(".calendar_system"), calendars_path)) %></td>
  </tr>
  <tr>
    <td><%= t("csv.headers.meals/meal.formula") %></td>
    <td><%= t(".formula_html", link: link_to(t(".formula"), meals_formulas_path)) %></td>
  </tr>
  <% if multi_community? %>
    <tr>
      <td><%= t("csv.headers.meals/meal.communities") %></td>
      <td><%= t(".communities") %></td>
    </tr>
  <% end %>
  <tr>
    <td><%= t(".role_column_html", role: t("csv.headers.meals/meal.role")) %></td>
    <td><%= t(".roles_html", link: link_to(t(".meal_role"), meals_roles_path)) %></td>
  </tr>
  <tr>
    <td><%= t("csv.headers.meals/meal.action") %></td>
    <td><%= t(".action") %></td>
  </tr>
  <tr>
    <td><%= t("csv.headers.meals/meal.id") %></td>
    <td><%= t(".id") %></td>
  </tr>
</table>

<h2><%= t(".example_data") %></h2>

<table id="example-csv">
  <thead>
    <tr>
      <td><%= t("csv.headers.meals/meal.served_at") %></td>
      <td><%= t("csv.headers.meals/meal.calendars") %></td>
      <td><%= t("csv.headers.meals/meal.formula") %></td>
      <% if @roles[0] %>
        <td><%= @roles[0].title %></td>
      <% end %>
      <% if @roles[1] %>
        <td><%= t("csv.headers.meals/meal.role") %><%= @roles[1].id %></td>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= @sample_times[0] %></td>
      <td><%= @locations.map(&:name).join("; ") %></td>
      <td><%= @formula.name %></td>
      <% if @roles[0] %>
        <td><%= t(".sample_worker_1") %></td>
      <% end %>
      <% if @roles[1] %>
        <td><%= t(".sample_workers_2") %></td>
      <% end %>
    </tr>
    <tr>
      <td><%= @sample_times[1] %></td>
      <td><%= @locations.map(&:id).join("; ") %></td>
      <td><%= @formula.id %></td>
      <% if @roles[0] %>
        <td><%= t(".sample_worker_3") %></td>
      <% end %>
      <% if @roles[1] %>
        <td><%= t(".sample_workers_4") %></td>
      <% end %>
    </tr>
  </tbody>
</table>
