<% if @import.successful? %>
  <div class="alert alert-success"><%= t(".succeeded") %></div>
  <%= t(".check_meals_html", link: link_to(t(".meals_page"), meals_path)) %>
<% elsif @import.crashed? %>
  <div class="alert alert-danger"><%= t(".crashed") %></div>
  <%= t(".crashed_try_again_html", link: link_to(t(".try_again_below"), "#upload")) %>
  <%= render("instructions_and_form") %>
<% else %>
  <div class="alert alert-danger"><%= t(".issues") %></div>
  <%= t(".resolve_html", link: link_to(t(".try_again"), "#upload")) %>
  <ul>
    <% @import.sorted_errors_by_row.each do |row_number, errors| %>
      <li>
        <strong><%= t(".row", number: row_number) %></strong>
        <ul>
          <% errors.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
  <%= render("instructions_and_form") %>
<% end %>
