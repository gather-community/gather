<section id="meal-menu">
  <h2 class="menu-label"><%= t(".menu") %></h2>
  <%= render("meals/meals/time_cook") %>
  <div id="details">
    <% if meal.location_name %>
      <div class="chunk">
        <%= t(".at_location", location: meal.location_name) %>
      </div>
    <% end %>
    <% if multi_community? %>
      <div class="chunk">
        <%= t(".for_communities", communities: meal.communities.map(&:name).join(", ")) %>
      </div>
    <% end %>
    <% meal.assignments_by_role.each do |role, assignments| %>
      <div class="chunk">
        <%= role.title %>
        <%= t("common.none_bracketed") if assignments.empty? %>
        <% assignments.each do |a| %>
          <div class="job"><%= a.user.decorate.link %></div>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if meal.menu_posted? %>
    <% meal.nonempty_menu_items.each do |item, text| %>
      <hr/>
      <div class="menu-label smaller"><%= item %></div>
      <section><%= safe_render_markdown(text) %></section>
    <% end %>
    <hr/>
    <div class="menu-label smaller"><%= t(".allergens") %></div>
    <section>
      <% if meal.allergens? %>
        <%= meal.allergens.join(", ") %>
      <% else %>
        <%= t("common.none_bracketed") %>
      <% end %>
    </section>
    <% if meal.menu_posted_at.present? %>
      <small><br/><%= t("meals.menu_posted_at", time: l(meal.menu_posted_at)) %></small>
    <% end %>
  <% else %>
    <hr/>
    <%= t(".no_menu") %>
  <% end %>
</section>
