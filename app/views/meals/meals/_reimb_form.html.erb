<div id="reimb-form">
  <table>
    <tr>
      <td><%= t(".meal") %></td>
      <td>
        <%= meal.title_or_no_title %><br/>
        <% if meal.head_cook %>
          <%= t(".by_cook", cook: meal.head_cook_name) %><br/>
        <% end %>
        <% if meal.location_name %>
          <%= t(".time_at_location", time: meal.served_at_datetime, location: meal.location_name) %>
        <% else %>
          <%= meal.served_at_datetime %>
        <% end %>
      </td>
    </tr>
    <tr>
      <td><%= t(".ingredients") %></td>
      <td><%= t(".amount_blank") %></td>
    </tr>
    <% if meal.formula.pantry_reimbursement? %>
      <tr>
        <td><%= t(".pantry") %></td>
        <td><%= t(".amount_blank") %></td>
      </tr>
      <tr>
        <td><%= t(".total") %></td>
        <td><%= t(".amount_blank") %></td>
      </tr>
    <% end %>
    <tr>
      <td><%= t(".method") %></td>
      <td>
        &#x25a2; <%= t(".account_credit") %><br/>
        &#x25a2; <%= t(".check_payable") %> <span class="payable-to"></span><br/>
        <% if current_community.settings.billing.paypal_reimbursement %>
          &#x25a2; <%= t(".paypal") %> <span class="payable-to"></span><br/>
        <% end %>
      </td>
    </tr>
  </table>
</div>
