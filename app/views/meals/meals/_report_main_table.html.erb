<% highlight = :all if local_assigns[:highlight].nil? %>
<% num_cols = 7 + (multi_community? ? @communities.size : 0) %>

<table class="by-<%= name %> stats <%= multi_community? ? 'multi-community' : '' %>">
  <tr class="surheader">
    <th></th>
    <th colspan="3" class="totals"><%= t(".totals") %></th>
    <th colspan="2" class="general-avg"><%= t(".general_averages") %></th>
    <% if multi_community? %>
      <th colspan="<%= @communities.size %>" class="cmty-rep"><%= t(".community_representation") %></th>
    <% end %>
  </tr>
  <tr class="header">
    <th></th>
    <th class="totals"><%= t(".meals") %></th>
    <th class="totals"><%= t(".servings") %></th>
    <th class="totals"><%= t(".cost") %></th>
    <th class="general-avg"><%= t(".full_meal_price") %></th>
    <th class="general-avg"><%= t(".servings") %></th>
    <% if multi_community? %>
      <% @communities.each do |community| %>
        <th class="cmty-rep"><%= community.name %></th>
      <% end %>
    <% end %>
  </tr>
  <% data.each do |period, cols| %>
    <tr class="<%= period == highlight ? %Q{highlight} : "" %>
      <%= period == :all ? "totals" : "" %>">
      <td>
        <%=
          case period
          when :all then t(".total")
          when Date then l(period, format: period_format)
          else period
          end %>
      </td>

      <% if cols == {} %>
        <%= (num_cols - 1).times.map { content_tag(:td, "-") }.reduce(:<<) %>
      <% else %>
        <td class="totals"><%= number_with_delimiter(cols["ttl_meals"]) %></td>
        <td class="totals"><%= number_with_delimiter(cols["ttl_servings"]) %></td>
        <td class="totals"><%= format_money(cols["ttl_cost"]) %></td>
        <td class="general-avg"><%= format_money(cols["avg_max_cost"]) %></td>
        <td class="general-avg"><%= number_with_precision(cols["avg_servings"], precision: 1) %></td>
        <% if multi_community? %>
          <% @communities.each do |c| %>
            <td class="cmty-rep">
              <span title="<%= number_with_precision(cols["avg_from_#{c.id}"], precision: 1) %>">
                <%= number_to_percentage(cols["avg_from_#{c.id}_pct"], precision: 0) %>
              </span>
            </td>
          <% end %>
        <% end %>
      <% end %>
    </tr>
  <% end %>
</table>
