<% @signup_parts.each do |part| %>
  <%= t(".part", count: part.count, type: part.type_name) %><br/>
<% end %>
<% if @signup.takeout? %>
  <p><%= t(".takeout_requested") %></p>
<% end %>
<% if @signup.comments.present? %>
  <em><%= t(".quoted_comments", comments: @signup.comments) %></em>
<% end %>
