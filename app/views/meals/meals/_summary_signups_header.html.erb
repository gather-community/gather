<tr>
  <% if multi_community? %>
    <th class="cmty"><%= t(".community") %></th>
  <% end %>
  <th class="hhld"><%= t(".household") %></th>
  <% meal.types.each do |type| %>
    <th class="count"><%= type.name %></th>
  <% end %>
  <% if meal.takeout_allowed? %>
    <th class="takeout"><%= t(".takeout") %></th>
  <% end %>
  <th><%= t(".comments") %></th>
</tr>
