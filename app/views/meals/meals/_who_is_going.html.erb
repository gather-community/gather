<section class="who-is-going">
  <h2><%= t(".title") %></h2>
  <% if @signups.empty? %>
    <%= t(".nobody") %>
  <% else %>
    <ul>
      <% @signups.each do |s| %>
        <li><%= t(".household_count", household: s.household.decorate.name_with_prefix, count: s.total) %></li>
      <% end %>
    </ul>
  <% end %>
</section>
