<% content_for(:title, t(".title")) %>
<% content_for(:action_links) do %>
  <%- concat(Calendars::ExportDecorator.new(current_community, current_user).legacy_export_link) %>
  <%- if policy(sample_meal).create? && policy(sample_meal).import? -%>
<div class="btn-group">
  <button type="button" class="btn btn-primary dropdown-toggle icon-only" data-toggle="dropdown"
    aria-haspopup="true" aria-expanded="false" aria-label="<%= t(".show_action_menu") %>">
    <%= icon_tag("plus") %></span>
  </button>
  <ul class="dropdown-menu dropdown-menu-right">
    <li><%= link_to(t(".create"), new_meal_path) %></li>
    <li><%= link_to(t(".import"), new_meals_import_path) %></li>
  </ul>
</div>
  <%- elsif policy(sample_meal).create? -%>
    <%- concat(link_to(icon_tag("plus") << " " << t(".create"), new_meal_path, class: "btn btn-primary")) %>
  <%- end -%>
<% end %>

<% if meals.empty? %>
  <div class="center-notice">
    <%= t(".no_meals") %> <%= lenses.no_result_clear_filter_link %>
  </div>
<% else %>
  <table class="index non-mobile">
    <thead>
      <tr>
        <th class="nowrap"><%= t(".date_time") %></th>
        <th><%= t(".location") %></th>
        <th><%= t(".cook") %></th>
        <th><%= t(".meal_title") %></th>
        <th><%= t(".going") %></th>
        <th><%= t(".signups") %></th>
      </tr>
    </thead>
    <tbody>
      <% meals.each do |meal| %>
        <tr class="<%= meal.css_classes %>">
          <td class="nowrap"><%= meal.served_at_lens_dependent(lenses[:time]) %></td>
          <td><%= meal.location_abbrv %></td>
          <td><%= meal.head_cook_name %></td>
          <td>
            <%= meal.link %>
            <%= icon_tag("lock") if meal.closed? %>
            <%= icon_tag("ban") if meal.cancelled? %>
            <%= icon_tag("certificate") if meal.finalized? %>
            <%= meal.closing_soon_pill if meal.auto_close_time_soon? %>
          </td>
          <td>
            <% if signup = meal.current_signup %>
              <% if policy(meal.sample_signup).update? %>
                <%= link_to(signup.total_diners_formatted, meal_url(meal)) %>
              <% else %>
                <%= signup.total_diners_formatted %>
              <% end %>
            <% elsif meal.full? %>
              <span class="weak"><%= t(".full") %></span>
            <% elsif policy(meal.sample_signup).create? %>
              <%= signup_link(meal) %>
            <% else %>
              <%= t(".not_going") %>
            <% end %>
          </td>
          <td><%= signup_count(meal) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="meals-list mobile">
    <% meals.each do |meal| %>
      <div class="meal <%= meal.css_classes %>">
        <h4 class="top">
          <% if meal.head_cook.present? %>
            <%= t(".meal_by_cook_html", meal: meal.link, cook: meal.head_cook_name) %>
          <% else %>
            <%= meal.link %>
          <% end %>
          <%= icon_tag("lock") if meal.closed? %>
          <%= icon_tag("certificate") if meal.finalized? %>
          <%= icon_tag("ban") if meal.cancelled? %>
          <%= meal.closing_soon_pill if meal.auto_close_time_soon? %>
        </h4>
        <div>
          <%= icon_tag("calendar") %>
          <%= t(".time_at_location", time: meal.served_at_lens_dependent(lenses[:time]), location: meal.location_abbrv) %>
        </div>
        <div><%= t(".signed_up_html", signups: signup_count(meal)) %></div>
        <% if (signup = meal.current_signup) %>
          <div class="signed-up">
            <%= t(".household_signed_up_html", diners: signup.total_diners_formatted) %>
            <%= link_to(t(".edit_signup"), meal_url(meal)) if policy(meal.sample_signup).update? %>
          </div>
        <% elsif meal.full? %>
          <span class="weak"><%= t(".full") %></span>
        <% elsif policy(meal.sample_signup).create? %>
          <%= signup_link(meal) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= gather_paginate(meals) %>
<% end %>

<% if policy(sample_meal).export? %>
  <footer id="local-footer" class="footer-links">
    <%= render("export_form", name: "meals", path: meals_path(format: :csv),
          label: t(".download_meals_csv"), ranges: @meal_ranges) %>
    &nbsp;&nbsp;
    <%= render("export_form", name: "signups", path: export_signups_meals_path(format: :csv),
          label: t(".download_signups_csv"), ranges: @meal_ranges) %>
  </footer>
<% end %>
