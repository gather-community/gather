<% deactivated = f.object.deactivated? %>
<td><%= f.input :contains, disabled: deactivated, label: false,
          placeholder: t(".restriction_placeholder"), input_html: {"aria-label": t(".restriction")} %></td>
<td><%= f.input :absence, disabled: deactivated, label: false,
          placeholder: t(".opposite_placeholder"), input_html: {"aria-label": t(".opposite")} %></td>
