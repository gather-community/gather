<% content_for(:title, t(".title")) %>

<% if users.empty? %>
  <div class="center-notice">
    <%= t(".no_users") %>
  </div>
<% else %>
  <table class="index part-width">
    <tbody>
      <% users.each do |user| %>
        <tr>
          <td><%= link_to(user.name, user) %></td>
          <td><%= user.birthday_formatted || t(".unknown") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
