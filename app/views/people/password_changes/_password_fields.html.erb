<%= safe_render_markdown(t("password.strength_info")) %>
<%= f.input(:password, label: t(".new_password"), autofocus: true) %>
<%= f.input(:password_confirmation, label: t(".retype_new_password")) %>
<%= form_actions do %>
  <div class="secondary-links">
    <%= link_to(t(".reveal"), "#", id: "reveal-link") %>
    <%= link_to(t(".mask"), "#", id: "mask-link", style: "display: none") %>
  </div>
  <div class="buttons">
    <%= f.button(:primary, :set_password) %>
  </div>
<% end %>
<script>
  $(function() {
    new Gather.Views.People.PasswordFormView({el: '.user-form'});
  });
</script>
