<% content_for(:title, t(".title")) %>

<% if vehicles.empty? %>
  <div class="center-notice">
    <%= t(".no_vehicles") %>
  </div>
<% else %>
  <table class="index part-width">
    <thead>
      <tr>
        <th><%= t(".vehicle") %></th>
        <th><%= t(".owner") %></th>
      </tr>
    </thead>
    <tbody>
      <% vehicles.each do |vehicle| %>
        <tr>
          <td><%= vehicle.make_model_etc %></td>
          <td><%= link_to(vehicle.household_name, vehicle.household) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
