<div class="type-filter-list" data-search-target="typeFilters">
  <% SearchController::ALL_TYPES_WITH_DRIVE.each do |type| %>
    <label class="type-filter-item">
      <input type="checkbox" value="<%= type %>"
             <%= "checked" if @types.include?(type) %>
             data-action="change->search#typeChanged">
      <%= t(".types.#{type}") %>
    </label>
  <% end %>
</div>
