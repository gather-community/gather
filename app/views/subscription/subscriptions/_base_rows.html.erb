<tr>
  <td><%= t(".num_users") %></td>
  <td><%= subscription.quantity %></td>
</tr>
<tr>
  <td><%= t(".tier") %></td>
  <td><%= t(".tier_value", tier: subscription.tier.capitalize, price: subscription.price_per_user) %></td>
</tr>
<% if subscription.discount_percent.present? %>
  <tr>
    <td><%= t(".discount") %></td>
    <td><%= subscription.discount_percent %>%</td>
  </tr>
<% end %>
<tr>
  <td><%= t(".months_per_cycle") %></td>
  <td><%= subscription.months_per_period %></td>
</tr>
<tr class="emphasis">
  <td><%= t(".total_payment") %></td>
  <td>
    <%= subscription.currency.upcase %>
    <%= subscription.total_payment_with_months %>
    <% if local_assigns[:prior_to_payment] %>
      <% if subscription.future? %>
        *
        <p>
          <%= t(".not_charged_until", date: I18n.l(subscription.start_date)) %>
        </p>
      <% elsif subscription.backdated? %>
        *
        <p>
          <%= t(".prorated", date: I18n.l(subscription.start_date)) %>
        </p>
      <% end %>
    <% end %>
  </td>
</tr>
