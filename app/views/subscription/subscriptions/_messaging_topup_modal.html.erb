<%# Modal for choosing the monthly messaging topup. Reuses the .gather-modal CSS shell but is driven
    by the messaging-topup Stimulus controller (not the generic modal), because it needs radios, a
    live proration notice, and its own submit. current_cents preselects the matching radio; it is the
    effectively-chosen amount, so a pending cancellation preselects None (what the user chose) rather
    than the amount that is winding down. %>
<% current_cents = topup&.selected_cents %>
<div class="gather-modal hiding" data-messaging-topup-target="modal"
     data-action="keydown.esc@window->messaging-topup#close">
  <div class="gather-modal-overlay" data-action="click->messaging-topup#close"></div>
  <div class="gather-modal-dialog" role="dialog" aria-modal="true">
    <div class="modal-header">
      <button class="close" type="button" data-action="click->messaging-topup#close" aria-label="<%= t("common.close") %>">
        <span aria-hidden="true">&times;</span>
      </button>
      <h2 class="modal-title"><%= t(".title") %></h2>
    </div>
    <div class="modal-body">
      <p class="hint">
        <%= t(".intro") %>
      </p>
      <div class="messaging-topup-options">
        <div class="radio">
          <label>
            <input type="radio" name="topup_choice" value="none"
                   data-action="messaging-topup#choose" <%= "checked" if current_cents.nil? %>>
            <%= t(".none") %>
          </label>
        </div>
        <% options.each do |opt| %>
          <div class="radio">
            <label>
              <input type="radio" name="topup_choice" value="<%= opt[:cents] %>"
                     data-messaging-topup-label="<%= opt[:label] %>"
                     data-action="messaging-topup#choose" <%= "checked" if opt[:cents] == current_cents %>>
              <%= t("subscription.per_month", amount: opt[:label]) %>
            </label>
          </div>
        <% end %>
      </div>
      <p class="messaging-topup-notice text-muted" data-messaging-topup-target="notice" hidden></p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-default" data-action="messaging-topup#close"><%= t(".cancel") %></button>
      <button type="button" class="btn btn-primary" data-messaging-topup-target="save"
              data-action="messaging-topup#save" disabled><%= t(".save") %></button>
    </div>
  </div>
</div>
