<h2>App Subscription</h2>
<p>
  <table class="key-value">
    <%= render("email_row", subscription: subscription) %>
    <tr>
      <td>Next Payment Date</td>
      <td>
        <%= I18n.l(subscription.next_payment_date) %>
      </td>
    </tr>
    <%= render("base_rows", subscription: subscription) %>
  </table>
</p>

<%# Hidden until the rest of messaging is ready to ship. Passing the user lets the flag be flipped to
    the "user" interface and enabled for individual users. %>
<% if FeatureFlag.lookup("messaging").on?(current_user) %>
  <%= render("messaging", subscription: subscription,
        topup: @messaging_topup&.decorate, account: @messaging_account) %>
<% end %>
