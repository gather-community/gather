<% content_for(:title, "Subscription") %>
<% content_for(:local_javascript, javascript_include_tag("https://js.stripe.com/v3/")) %>
<% content_for(:local_viewport, "minimum-scale=1") %>

<% if subscription.new_record? %>
  <div class="topline">You don't have a Gather subscription yet.</div>
  <p><%= link_to("Set up your subscription", subscription_new_path, class: "btn btn-primary") %></p>

<% elsif subscription.dead? %>
  <div class="topline">
    Your subscription has ended. You can start a new one whenever you're ready.
  </div>
  <p><%= link_to("Start a new subscription", subscription_new_path, class: "btn btn-primary") %></p>

<% elsif subscription.payment_requires_microdeposits? %>
  <div class="topline">
    Your bank account requires verification.
    <% if subscription.microdeposit_verification_url %>
      A <%= link_to("microdeposit", Subscription::Subscription::MICRODEPOSIT_HELP_URL,
            target: "_blank", rel: "noopener") %>
      will land in your account in a day or two. Use the button below to complete verification.
    <% else %>
      Please check your email for instructions and check back here once verification is complete.
    <% end %>
  </div>
  <% if subscription.microdeposit_verification_url %>
    <p>
      <%= link_to("Verify your bank account", subscription.microdeposit_verification_url,
            class: "btn btn-primary", target: "_blank", rel: "noopener") %>
    </p>
  <% end %>
  <%= render("post_payment", subscription: subscription) %>
  <%= render("billing_portal_link") %>

<% elsif subscription.needs_payment_method? %>
  <div class="topline">
    Your subscription is active but we still need to collect your payment information.
  </div>
  <%= render("pre_payment", subscription: subscription) %>

<% elsif subscription.incomplete? %>
  <div class="topline">Your subscription is ready for payment.</div>
  <%= render("pre_payment", subscription: subscription) %>

<% elsif subscription.revivable? %>
  <div class="topline">
    There was a problem with your last payment, so your subscription is past due. Enter your payment
    details below to pay the outstanding invoice and get back on track.
  </div>
  <%= render("pre_payment", subscription: subscription) %>

<% elsif subscription.detailed_status == :payment_processing %>
  <div class="topline">
    Your subscription payment is processing. This can take a few days depending on the
    payment method. In the meantime, you are welcome to use Gather!
  </div>
  <%= render("post_payment", subscription: subscription) %>
  <%= render("billing_portal_link") %>

<% elsif subscription.detailed_status == :scheduled %>
  <div class="topline">
    Your subscription is set up and scheduled to start on
    <%= I18n.l(subscription.start_date) %>. Thanks for being a part of Gather!
  </div>
  <%= render("post_payment", subscription: subscription) %>
  <%= render("billing_portal_link") %>

<% elsif subscription.active? %>
  <div class="topline">
    Your subscription is active. Thanks for being a part of Gather!
  </div>
  <%= render("post_payment", subscription: subscription) %>
  <%= render("billing_portal_link") %>

<% else %>
  <div class="topline">There is a problem with your subscription.</div>
  <%= render("billing_portal_link") %>
<% end %>
