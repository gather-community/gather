<div class="transaction-core-fields">
  <%# We include the hints explicitly because these fields are used on multiple forms
      so automatic lookup doesn't work %>
  <%= f.input :code, as: :radio_buttons, hint: t("simple_form.hints.billing_transaction.code") do %>
    <div class="transaction-code-columns">
      <% {increase: :charges, decrease: :credits}.each do |effect, heading| %>
        <div class="transaction-code-column">
          <div class="transaction-code-heading"><%= t(".#{heading}") %></div>
          <%# include_hidden is off because each column would add its own blank hidden field, and the
              last one would override a choice made in the first column. %>
          <%= f.collection_radio_buttons(:code, f.object.transaction_code_options(effect), :last, :first,
                                         include_hidden: false, boolean_style: :inline,
                                         item_wrapper_tag: false) do |b| %>
            <div class="radio"><%= b.label { b.radio_button + b.text } %></div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= f.input :description, hint: t("simple_form.hints.billing_transaction.description")  %>
  <%= f.input :value, input_html: {value: number_with_precision(f.object.value, precision: 2)},
                      hint: t("simple_form.hints.billing_transaction.value") %>
</div>
