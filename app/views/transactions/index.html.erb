<% content_for(:title, account.household == current_user.household ? t(".title") :
                         t(".title_with_household", household: account.household_name)) %>

<table class="key-value key-value-narrow">
  <% if multi_community? %>
    <tr>
      <td><%= t(".account_community") %></td>
      <td><%= @community.name %></td>
    </tr>
  <% end %>
  <tr>
    <td><%= t(".account_number") %></td>
    <td><%= account.number_padded %></td>
  </tr>
  <tr>
    <td><%= t(".household") %></td>
    <td><%= account.household_name %></td>
  </tr>
</table>

<h2><%= t(".activity") %></h2>

<% if transactions.none? && last_statement.nil? %>
  <div class="center-notice"><%= t(".no_activity") %></div>
<% else %>
  <%# Full keys below: lazy lookup inside a render(layout:) block resolves against the layout's path. %>
  <%= render(layout: "txn_table") do %>
    <tr>
      <td><%= l(last_statement&.created_on) %></td>
      <td></td>
      <td><%= t("transactions.index.last_statement_balance") %></td>
      <td></td>
      <td></td>
      <td class="num"><%= currency_with_cr_span(last_statement&.total_due || 0) %></td>
    </tr>

    <%= render("transactions/txn_rows", transactions: transactions) %>

    <tr class="total">
      <td></td>
      <td></td>
      <td><%= t("transactions.index.current_balance") %></td>
      <td></td>
      <td></td>
      <td class="num"><%= currency_with_cr_span(account.current_balance) %></td>
    </tr>
  <% end %>
<% end %>
