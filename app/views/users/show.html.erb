<% content_for(:title, user.name) %>
<% content_for(:action_links, user.action_links) %>

<% content_for(:mobile_back_link) do %>
  <%= render partial: "shared/mobile_back_link", locals: {label: t(".directory"), path: users_path } %>
<% end %>

<% if user.pronouns.present? %>
  <% content_for(:title_footnote, "(#{user.pronouns})") %>
<% end %>

<div class="row">
  <div class="col-sm-12">
    <div class="row">
      <div class="col-sm-4">
        <%= user.photo_if_permitted(:medium) %>
        <% user.roles.each do |role| %>
          <div class="pill pill-normal"><%= icon_tag("star") %> <%= t("roles.#{role.name}") %></div>
        <% end %>
        <% @memberships.each do |mship| %>
          <% icon = mship.manager? ? "users-cog" : "users" %>
          <% label = icon_tag(icon) << " " << mship.group_name %>
          <% if policy(mship.group).show? %>
            <%= link_to(label, mship.group, class: "pill pill-normal") %>
          <% else %>
            <div class="pill pill-normal"><%= label %></div>
          <% end %>
        <% end %>
      </div>
      <div class="col-sm-8">
        <table class="key-value key-value-full">
          <%= render("households/unit_community", household: user.household) %>
          <% if user.email? %>
            <tr>
              <td><%= t(".email") %></td>
              <td>
                <%= user.email_link %>
                <% if user.unconfirmed_email? && policy(user).update_info? %>
                  <br/>
                  <em>
                    <%= t(".pending_confirmation", email: user.unconfirmed_email) %><br/>
                    <%= link_to(t(".resend_confirmation"),
                          resend_email_confirmation_user_path(@user), method: :put) %> |
                    <%= link_to(t(".cancel_change"),
                          cancel_email_change_user_path(@user), method: :delete) %>
                  </em>
                <% elsif !user.confirmed? %>
                  <div class="small">
                    <%= t(".unconfirmed") %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% unless user.no_phones? %>
            <tr>
              <td><%= t(".phone") %></td>
              <td class="phones">
                <%= safe_join(user.phones.map{ |p| phone_link(p, kind_abbrv: true) }, tag(:br)) %>
              </td>
            </tr>
          <% end %>
          <% if user.preferred_contact %>
            <tr>
              <td><%= t(".preferred_contact") %></td>
              <td><%= user.preferred_contact %></td><%# The decorator translates it. %>
            </tr>
          <% end %>
          <% if policy(user).show_personal_info? %>
            <% if user.birthday? %>
              <tr>
                <td><%= t(".birthday") %></td>
                <td><%= user.birthday_formatted %></td>
              </tr>
            <% end %>
            <% if user.age.present? %>
              <tr>
                <td><%= t(".age") %></td>
                <td><%= user.age %></td>
              </tr>
            <% end %>
            <% if user.joined_on.present? %>
              <tr>
                <td><%= t(".joined_on") %></td>
                <td><%= user.joined_on %></td>
              </tr>
            <% end %>
            <% %i(school allergies doctor medical).each do |attr| %>
              <% if user[attr].present? %>
                <tr>
                  <td><%= User.human_attribute_name(attr) %></td>
                  <td><%= user[attr] %></td>
                </tr>
              <% end %>
            <% end %>
            <% if user.meal_restriction_ids.any? %>
              <tr>
                <td>Meal Restrictions</td>
                <td><%= user.meal_restrictions.map(&:absence).sort.join(", ") %></td>
              </tr>
            <% end %>
            <% unless @user.custom_data.undefined? %>
              <%= render("custom_fields/group_entry_show", group_entry: @user.custom_data,
                                                            hide_title: true) %>
            <% end %>
          <% end %>
          <% @households_and_members.each do |household, members| %>
            <%= render("households/attribs",
                  household: household,
                  members: members,
                  context: :user,
                  child: user.child?) %>
          <% end %>
        </table>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-12">
        <% if head_cook_meals.any? %>
          <h2><%= t(".recent_head_cook_meals") %></h2>
          <table class="index part-width">
            <tr>
              <th class="col-md-1"><%= t(".date") %></th>
              <th class="col-md-3"><%= t(".meal_title") %></th>
              <th class="col-md-1"><%= t(".signups") %></th>
            </tr>
            <% head_cook_meals.each do |meal| %>
              <tr>
                <td class="col-md-1">
                  <%= l(meal.served_at.to_date) %>
                </td>
                <td class="col-md-3">
                  <%= link_to(meal.title_or_no_title, meal_url(meal)) %>
                </td>
                <td class="col-md-1">
                  <%= meal.signup_count %>
                </td>
              </tr>
            <% end %>
          </table>
        <% end %>
      </div>
    </div>
  </div>
</div>
