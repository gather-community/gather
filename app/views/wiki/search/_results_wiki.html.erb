<% if results.empty? %>
  <div class="center-notice">No Wiki pages found.</div>
<% else %>
  <ul class="search-result-list">
    <% results.each do |result| %>
      <li>
        <div class="result-title">
          <% if (hl_title = result.highlight&.title&.first) %>
            <%= link_to(raw(hl_title), wiki_page_path(slug: result.slug)) %>
          <% else %>
            <%= link_to(result.title, wiki_page_path(slug: result.slug)) %>
          <% end %>
        </div>
        <% if (snippet = result.highlight&.content&.first) %>
          <div class="result-snippet detail"><%= raw(snippet) %>&hellip;</div>
        <% end %>
        <% if (at = result.updated_at.presence) %>
          <div class="detail">
            Updated <%= l(Time.zone.parse(at), format: :short) rescue at %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
