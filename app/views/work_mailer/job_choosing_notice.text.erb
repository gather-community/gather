<%= @user.greeting %>

<% if @period.auto_open_time %>
<%= t(".coming_up_on", date: l(@period.auto_open_time.to_date, format: :wday_no_year)) %>
<% else %>
<%= t(".coming_up_soon") %>
<% end %>

<%= t(".quota", got: @synopsis.user_regular_got, quota: @synopsis.user_adjusted_quota, need: @synopsis.user_need) %>

<% if @synopsis.user_full_community_hours.any? %>
<%= t(".also_choose", hours: @synopsis.user_full_community_hours.map { |job, hours| t(".full_community_hours", hours: hours, title: job.title) }.join(", ")) %>
<% end %>

<% if @period.staggered? && @synopsis.user_need > 0 %>
  <% if @synopsis.rounds.one? %>
<%= t(".begin_at", time: l(@synopsis.rounds[0][:starts_at], format: :time_only).strip) %>
  <% else %>
<%= t(".schedule_intro") %>
    <% @synopsis.rounds.each do |round| %>
<% time = l(round[:starts_at], format: :time_only).strip %>
<%= round[:limit] ? t(".round_with_limit", time: time, limit: round[:limit]) : t(".round_finish", time: time) %>
    <% end %>
  <% end %>

<%= t(".go_to", url: work_period_shifts_url(@period)) %>
<% else %>
  <% if @period.auto_open_time %>
<%= t(".choosing_begins", time: l(@period.auto_open_time, format: :time_only).strip) %>

  <% end %>
<%= t(".visit", url: work_period_shifts_url(@period)) %>
<% end %>

<%= t(".thanks") %>
