#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=bin/include/dev_port.sh
source "$ROOT_DIR/bin/include/dev_port.sh"

# Exported for Procfile.dev. Not named PORT because foreman overwrites that for every process.
GATHER_PORT="$(dev_port)"
export GATHER_PORT

# True if something accepts connections on host:port. Uses bash's /dev/tcp so it works without nc.
port_open() {
  timeout 1 bash -c ": < /dev/tcp/$1/$2" 2>/dev/null
}

# Check if the port is already in use locally (stale Thin process in this container).
if port_open localhost "$GATHER_PORT"; then
  echo "Port $GATHER_PORT is already in use inside this container (stale server process?)."
  echo ""
  echo "Find and kill the process: lsof -i :$GATHER_PORT"
  echo "Then re-run bin/dev."
  exit 1
fi

# Check if the port is already claimed by another dev env on the Mac host.
# NOTE: VS Code forwards ports to 127.0.0.1 on the Mac, which is NOT reachable via
# host.docker.internal from inside the container. This check catches processes that
# bind to 0.0.0.0 on the Mac (e.g. another devcontainer's VS Code tunnel), but will
# miss conflicts where the Mac's localhost port is taken by a VS Code port forward.
# If VS Code forwards this container's port to a different number on the Mac, it means
# something else has that port there — check the VS Code Ports panel.
if port_open host.docker.internal "$GATHER_PORT"; then
  echo "Port $GATHER_PORT is already in use on the host."

  current_env="$(basename "$ROOT_DIR")"
  owner=$(docker ps --format "{{.Names}}" 2>/dev/null \
    | grep -oE "^gather[^-]+" | sort -u \
    | grep -v "^${current_env}$" || true)
  [[ -n "$owner" ]] && echo "Possibly in use by: $owner (devcontainer port forward)"

  echo ""
  echo "Stop the other server, or give this dev env its own port by setting url.port"
  echo "in config/settings.local.yml. Then re-run bin/dev."
  exit 1
fi

if ! foreman version &> /dev/null; then
  echo "Installing foreman..."
  gem install foreman
fi

# After Thin binds the port, print a prominent banner reminding the user to verify
# VS Code forwarded it to the same port on the Mac. This runs in the background so it
# appears after startup noise settles rather than being buried by foreman's output.
# We can't detect the Mac-side conflict pre-flight: VS Code binds forwarded ports to
# 127.0.0.1 on the Mac, which isn't reachable via host.docker.internal.
(
  for _ in $(seq 1 30); do
    port_open localhost "$GATHER_PORT" && break
    sleep 1
  done
  sleep 2
  echo ""
  echo "========================================================"
  echo "  Server up: https://gatherdev.org:$GATHER_PORT"
  echo ""
  echo "  ACTION: Check VS Code Ports panel (bottom bar > PORTS)"
  echo "  Port $GATHER_PORT should show Forwarded Address: localhost:$GATHER_PORT"
  echo "  If it shows a different port, another server holds"
  echo "  Mac port $GATHER_PORT. Stop it, then restart bin/dev."
  echo "========================================================"
  echo ""
) &
CHECKER_PID=$!

foreman start -f Procfile.dev "$@"
kill "$CHECKER_PID" 2>/dev/null || true
