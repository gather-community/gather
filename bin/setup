#!/usr/bin/env bash
set -euo pipefail

abort() {
  echo
  echo "Aborting Gather setup..."
  exit 1
}

trap abort INT

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source utilities and stage modules
source "$SCRIPT_DIR/include/utils.sh"
source "$SCRIPT_DIR/include/deps.sh"
source "$SCRIPT_DIR/include/conf.sh"
source "$SCRIPT_DIR/include/data.sh"
source "$SCRIPT_DIR/include/ssl.sh"

cd "$ROOT_DIR"

STAGES=(deps conf data ssl)

usage() {
  echo "Usage: bin/setup [stage]"
  echo
  echo "Stages:"
  echo "  deps    Check development dependencies"
  echo "  conf    Generate configuration files"
  echo "  data    Setup data services and provision database"
  echo "  ssl     Configure SSL certificates"
  echo
  echo "If no stage is provided, all stages run in order."
}

stage_name() {
  case "$1" in
    deps) echo "Dependencies" ;;
    conf) echo "Configuration" ;;
    data) echo "Data services" ;;
    ssl)  echo "SSL certificates" ;;
  esac
}

run_stage() {
  local stage="$1"
  local show_complete="${2:-true}"
  case "$stage" in
    deps) run_deps ;;
    conf) run_conf ;;
    data) run_data ;;
    ssl)  run_ssl ;;
    *)
      msg_error "Unknown stage: $stage"
      echo
      usage
      return 1
      ;;
  esac
  if [[ "$show_complete" == "true" ]]; then
    echo
    msg_success "$(stage_name "$stage") complete."
  fi
}

run_all() {
  for stage in "${STAGES[@]}"; do
    run_stage "$stage" false || return 1
    echo
  done
  msg_success "Gather setup complete."
  _data_print_access_info
}

main() {
  if [[ $# -eq 0 ]]; then
    run_all
  elif [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
  else
    run_stage "$1"
    _data_print_access_info
  fi
}

main "$@"
