# Docker Compose Environment Configuration
# Copy this file to .env and customize the values

# Rails Configuration
RAILS_ENV=development
RAILS_PORT=3000
RAILS_LOG_TO_STDOUT=true
SECRET_KEY_BASE=your_secret_key_here

# Dockerfile Build Configuration
RUBY_VERSION=3.2.2
NODE_VERSION=18
BUNDLE_JOBS=4
BUNDLE_PATH=/usr/local/bundle
INSTALL_DEV_TOOLS=true

# Health Check Configuration
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_START_PERIOD=5s
HEALTHCHECK_RETRIES=3

# Database Configuration
DATABASE_URL=postgresql://postgres:password@postgres:5432/gather_development
POSTGRES_DB=gather_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
POSTGRES_VERSION=15

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_VERSION=7-alpine

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_VERSION=7.17.0
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Optional: Override any settings from config/settings.local.yml
# SETTINGS__OAUTH__GOOGLE__CLIENT_ID=your_google_client_id
# SETTINGS__OAUTH__GOOGLE__CLIENT_SECRET=your_google_client_secret
# SETTINGS__EMAIL__FROM=Gather <noreply@example.coop>
# SETTINGS__EMAIL__WEBMASTER=someone@example.com
