default: &default
  adapter: postgresql
  pool: 5
  timeout: 5000
  host: <%= @pg_host %>
  port: <%= @pg_port %>
<%- if @pg_user && !@pg_user.empty? -%>
  username: <%= @pg_user %>
<%- end -%>
<%- if @pg_password && !@pg_password.empty? -%>
  password: <%= @pg_password %>
<%- end -%>

development:
  <<: *default
  database: gather_development

test:
  <<: *default
  database: gather_test

production:
  <<: *default
  database: gather_production
