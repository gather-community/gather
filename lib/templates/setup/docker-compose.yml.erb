services:
<%- if @pg_source == "docker" -%>
  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: <%= @pg_user %>
      POSTGRES_PASSWORD: <%= @pg_password %>
      POSTGRES_DB: gather_development
    ports:
      - "<%= @pg_port %>:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - gather-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U <%= @pg_user %>"]
      interval: 5s
      timeout: 5s
      retries: 5

<%- end -%>
<%- if @redis_source == "docker" -%>
  redis:
    image: redis:7-alpine
    ports:
      - "<%= @redis_port %>:6379"
    volumes:
      - redis_data:/data
    networks:
      - gather-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

<%- end -%>
<%- if @es_source == "docker" -%>
  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:6.8.23
    environment:
      - discovery.type=single-node
      - "ES_JAVA_OPTS=-Xms200m -Xmx200m"
      - xpack.security.enabled=false
    ports:
      - "<%= @es_port %>:9200"
      - "9300:9300"
    volumes:
      - elasticsearch_data:/usr/share/elasticsearch/data
    networks:
      - gather-network
    healthcheck:
      test: ["CMD-SHELL", "curl -s http://localhost:9200/_cluster/health | grep -vq '\"status\":\"red\"'"]
      interval: 10s
      timeout: 10s
      retries: 10

<%- end -%>
  mailcatcher:
    image: schickling/mailcatcher
    ports:
      - "1025:1025"
      - "1080:1080"
    networks:
      - gather-network

volumes:
<%- if @pg_source == "docker" -%>
  postgres_data:
<%- end -%>
<%- if @redis_source == "docker" -%>
  redis_data:
<%- end -%>
<%- if @es_source == "docker" -%>
  elasticsearch_data:
<%- end -%>

networks:
  gather-network:
    external: true
